    def loop_theme(self) -> None:
        while True:
            try:
                t = read_theme()
                with self.lock:
                    self.theme = t
            except Exception as e:   # noqa: BLE001
                log(f"theme: {e}")
            try:
                self.reload()
                self.expire_agents()
                self.check_focus()
            except Exception as e:   # noqa: BLE001
                log(f"reload: {e}")
            time.sleep(3)

    # -- Hyprland: window coverage on each monitor and screen sharing (privacy)
    def loop_hypr(self) -> None:
        threading.Thread(target=self.loop_hypr_refresh, daemon=True).start()
        while True:
            path = hypr_socket()
            if not path:
                time.sleep(5)
                continue
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.connect(path)
                self.hypr_dirty.set()
                buf = b""
                while True:
                    data = s.recv(4096)
                    if not data:
                        break
                    buf += data
                    *lines, buf = buf.split(b"\n")
                    for line in lines:
                        ev, _, arg = line.decode("utf-8", "replace").partition(">>")
                        if ev == "screencast":
                            on = arg.split(",")[0] == "1"
                            if on != self.screencast:
                                log("screen sharing " + ("started: privacy on" if on else "stopped"))
                            self.screencast = on
                        elif ev in ("workspace", "workspacev2", "openwindow", "closewindow", "movewindow", "movewindowv2",
                                    "fullscreen", "focusedmon", "focusedmonv2", "changefloatingmode", "monitoradded",
                                    "monitorremoved", "activespecial", "minimized"):
                            self.hypr_dirty.set()
                s.close()
            except Exception:   # noqa: BLE001
                pass
            time.sleep(2)

    def loop_hypr_refresh(self) -> None:
        while True:
            self.hypr_dirty.wait(10)
            time.sleep(0.25)
            self.hypr_dirty.clear()
            try:
                def query(what):
                    result = subprocess.run(["hyprctl", "-j", what], capture_output=True, timeout=3,
                                            env=hypr_env(), check=True)
                    data = json.loads(result.stdout)
                    if not isinstance(data, list):
                        raise ValueError("invalid Hyprland response")
                    return data
                mons = query("monitors")
                wss = {w["id"]: w for w in query("workspaces")}
                clients = query("clients")
                out = {}
                for m in mons:
                    w = wss.get((m.get("activeWorkspace") or {}).get("id"), {})
                    sp = (m.get("specialWorkspace") or {}).get("id")
                    out[f"{m.get('x', 0)},{m.get('y', 0)}"] = {"name": m.get("name"), "windows": w.get("windows", 0),
                        "fullscreen": bool(w.get("hasfullscreen")) or bool(sp),
                        "covered": monitor_covered(m, clients)}
                with self.lock:
                    self.mons = out
                saver = any("screensaver" in str(c.get("class", "")).lower() for c in clients)
                if self.conf("presence", "lock", default=True) is not False:
                    if saver and not self.away:
                        self.set_away(True, "screensaver")
                    elif not saver and self.away and self.away.get("why") == "screensaver" and not self.locked:
                        self.set_away(False)
            except Exception:   # noqa: BLE001 - fail open if the compositor state is unavailable
                with self.lock:
                    self.mons = {}

    # -- privacy
    def privacy(self) -> bool:
        if self.privacy_manual is not None:
            return self.privacy_manual
        return self.screencast and self.conf("pulse", "privacy_on_screenshare", default=True) is not False

    # -- what the page reads
    def state(self) -> dict:
        with self.lock:
            ws = []
            for w in self.widgets.values():
                d = {k: v for k, v in w.items() if not k.startswith("_")}
                if w["id"] in self.images:
                    d["data"] = {**d.get("data", {}), "frame": self.images[w["id"]][2]}
                ws.append(d)
            return {"v": VERSION, "t": time.time(), "demo": self.demo, "sys": self.sys,
                    "hist": {k: list(v) for k, v in self.hist.items()}, "weather": self.weather,
                    "widgets": ws, "alerts": list(self.alerts), "privacy": self.privacy(), "screencast": self.screencast,
                    "mons": self.mons, "theme": self.colors(),
                    "agents": sorted(self.agents.values(), key=lambda a: a.get("since", 0)), "focus": self.focus,
                    "fxSeq": self.fx_seq, "music": bool(self.audio) and time.time() - self.audio_t < 1,
                    "away": bool(self.away), "digest": self.public_digest(),
                    "lan": [{**d, "name": "" if self.privacy() else d["name"], "ip": "" if self.privacy() else d["ip"]}
                            for d in self.lan["devices"]],
                    "ui": {"fps": self.conf("pulse", "fps", default=20), "clock": self.conf("pulse", "clock", default="24h"),
                           "pause_when_covered": self.conf("pulse", "pause_when_covered", default=True),
                           "scene": self.conf("pulse", "scene", default="skyline"),
                           "font": self.conf("pulse", "font", default=""),
                           "title": self.conf("pulse", "title", default=""),
                           "dim_with_windows": self.conf("pulse", "dim_with_windows", default=True),
                           "system": self.builtin("system") is not False, "network": self.builtin("network") is not False,
                           "face": self.conf("pulse", "face", default="agents"),
                           "fireworks": self.conf("pulse", "celebrate", default=True) is not False,
                           "music": self.conf("music", "enabled", default="auto") not in (False, "off"),
                           "sun": self.conf("pulse", "sun", default=True) is not False,
                           "sphere": self.conf("pulse", "sphere", default="real"),
                           "cars": self.conf("lan", "cars", default=True) is not False,
                           "eyes": self.conf("presence", "eyes", default=True) is not False}}

    def public_digest(self):
        d = self.digest
        if not d or time.time() - d["until"] > 600:
            return None
        if self.privacy():
            return {**d, "lines": [x for x in d["lines"] if not x.get("private")]}
        return d

    def colors(self) -> dict:
        """The theme's colours, or a [colors] preset, with any single colour of [colors] on top."""
        c = self.conf("colors", default={}) or {}
        preset = str(c.get("preset", "theme"))
        base = dict(self.theme.get("colors") or {}) if preset == "theme" or preset not in PRESETS else \
            {COLOR_KEYS[k]: v for k, v in PRESETS[preset].items()}
        for k, v in c.items():
            if k in COLOR_KEYS and isinstance(v, str) and re.match(r"^#[0-9a-fA-F]{6}$", v):
                base[COLOR_KEYS[k]] = v
        return {"name": self.theme.get("name", ""), "colors": base, "preset": preset}

    def start(self) -> None:
        self.reload(force=True)
        if self.demo:
            from_demo(self)
            return
        for fn in (self.loop_system, self.loop_weather, self.loop_github, self.loop_media, self.loop_notifications,
                   self.loop_theme, self.loop_hypr, self.loop_music, self.loop_presence, self.loop_lan,
                   self.loop_voice):
            threading.Thread(target=fn, daemon=True).start()


# ---------------------------------------------------------------- small readers

def read_gpu():
    for p in Path("/sys/class/drm").glob("card*/device/gpu_busy_percent"):
        try:
            return float(p.read_text().strip())
        except Exception:   # noqa: BLE001
            pass
    if shutil.which("nvidia-smi"):
        try:
            r = subprocess.run(["nvidia-smi", "--query-gpu=utilization.gpu", "--format=csv,noheader,nounits"],
                               capture_output=True, text=True, timeout=3)
            return float(r.stdout.split()[0])
        except Exception:   # noqa: BLE001
            pass
    return None


def read_temp():
    best = None
    for hw in Path("/sys/class/hwmon").glob("hwmon*"):
        try:
            name = (hw / "name").read_text().strip()
        except Exception:   # noqa: BLE001
            continue
        if name not in ("coretemp", "k10temp", "zenpower", "cpu_thermal", "acpitz", "macsmc_hwmon", "thinkpad"):
            continue
        for t in hw.glob("temp*_input"):
            try:
                v = int(t.read_text()) / 1000
                if 0 < v < 130:
                    best = v if best is None else max(best, v)
            except Exception:   # noqa: BLE001
                pass
    return round(best, 1) if best is not None else None


def read_battery():
    # BAT0 on most laptops, macsmc-battery on Apple Silicon. Mice and headsets are batteries too, with scope Device.
    for b in sorted(Path("/sys/class/power_supply").glob("*")):
        try:
            if (b / "type").read_text().strip() != "Battery":
                continue
            if (b / "scope").exists() and (b / "scope").read_text().strip() == "Device":
                continue
            return {"pct": int((b / "capacity").read_text()), "status": (b / "status").read_text().strip()}
        except Exception:   # noqa: BLE001
            pass
    return None


_ip_cache = ("", 0.0)


def local_ip() -> str:
    global _ip_cache
    if time.time() - _ip_cache[1] < 30:
        return _ip_cache[0]
    ip = ""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("192.0.2.1", 9))   # no packet is sent: it only picks the outgoing interface
        ip = s.getsockname()[0]
        s.close()
    except Exception:   # noqa: BLE001
        pass
    _ip_cache = (ip, time.time())
    return ip


def http_json(url: str, headers: dict | None = None):
    req = urllib.request.Request(url, headers={"User-Agent": "omarchy-pulse/" + VERSION, **(headers or {})})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.loads(r.read())


def gh_api(path: str, auth_only: bool = False):
    if shutil.which("gh"):
        r = subprocess.run(["gh", "api", path], capture_output=True, timeout=20)
        if r.returncode == 0:
            return json.loads(r.stdout)
        if auth_only:
            return None
    if auth_only:
        return None
    return http_json("https://api.github.com/" + path, {"Accept": "application/vnd.github+json"})


def iso_ts(s):
    if not s:
        return None
    try:
        import datetime as dt
        return dt.datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except Exception:   # noqa: BLE001
        return None


def notification_history() -> list:
    """Read Omarchy 4.5's notification store, with a fallback for Mako."""
    state = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "omarchy/notifications"
    paths = (state / "live.json", state / "history.json")
    if any(p.is_file() for p in paths):
        entries = []
        for path in paths:
            try:
                if path.stat().st_size > 4_000_000:
                    continue
                rows = json.loads(path.read_text())
                if isinstance(rows, list):
                    entries.extend(row for row in rows[:100] if isinstance(row, dict))
            except (OSError, ValueError):
                continue
        def timestamp(row):
            value = row.get("ts")
            if not (isinstance(value, (int, float)) and value == value):
                return 0
            return value / 1000 if value > 1e11 else value   # seconds, whether the store keeps seconds or ms
        entries.sort(key=timestamp, reverse=True)
        result, seen = [], set()
        for row in entries:
            key = row.get("key")
            if isinstance(key, str) and key in seen:
                continue
            if isinstance(key, str):
                seen.add(key)
            result.append({"title": str(row.get("summary") or "")[:120],
                           "text": str(row.get("body") or "")[:160],
                           "right": str(row.get("app") or "")[:80], "t": timestamp(row)})
            if len(result) == 5:
                break
        return result
    return mako_history() if shutil.which("makoctl") else []


def mako_history() -> list:
    r = subprocess.run(["makoctl", "history"], capture_output=True, text=True, timeout=3)
    out = r.stdout.strip()
    items = []
    try:   # older mako: JSON
        j = json.loads(out)
        for n in (j.get("data") or [[]])[0]:
            items.append({"title": n.get("summary", {}).get("data", ""), "text": n.get("body", {}).get("data", "")[:160],
                          "right": n.get("app-name", {}).get("data", "")})
        return items
    except ValueError:
        pass
    cur = None
    for line in out.splitlines():   # mako 1.9+: text
        m = re.match(r"^Notification \d+: (.*)$", line)
        if m:
            cur = {"title": m.group(1)}
            items.append(cur)
        elif cur is not None:
            k, _, v = line.strip().partition(": ")
            if k == "App name":
                cur["right"] = v
            elif k == "Body" or (not v and line.startswith("  ") and "text" not in cur and k):
                cur["text"] = (v or k)[:160]
    return items


def theme_name() -> str:
    for f in (HOME / ".local/state/omarchy/current/theme.name", HOME / ".config/omarchy/current/theme.name"):
        if f.is_file() and f.read_text().strip():
            return f.read_text().strip()
    old = HOME / ".config/omarchy/current/theme"
    if old.is_symlink() or old.is_dir():
        return old.resolve().name
    return ""


_theme_cache: dict = {}


def read_theme() -> dict:
    name = theme_name()
    for d in (HOME / ".config/omarchy/current/theme", HOME / ".config/omarchy/themes" / name,
              HOME / ".local/share/omarchy/themes" / name):
        f = d / "colors.toml"
        if name and f.is_file():
            m = f.stat().st_mtime
            if _theme_cache.get("key") == (str(f), m):
                return _theme_cache["val"]
            with open(f, "rb") as fh:
                c = tomllib.load(fh)
            val = {"name": name, "colors": {k: v for k, v in c.items() if isinstance(v, str) and v.startswith("#")}}
            _theme_cache.update(key=(str(f), m), val=val)
            return val
    return {"name": name, "colors": {}}


def hypr_env() -> dict:
    env = dict(os.environ)
    rt = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    sig = env.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig or not (Path(rt) / "hypr" / sig).is_dir():
        try:
            dirs = sorted((Path(rt) / "hypr").iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)
            if dirs:
                env["HYPRLAND_INSTANCE_SIGNATURE"] = dirs[0].name
        except Exception:   # noqa: BLE001
            pass
    return env


def hypr_cursor() -> list | None:
    """The pointer in layout pixels, from Hyprland's request socket (no process started)."""
    env = hypr_env()
    rt = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    sig = env.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(str(Path(rt) / "hypr" / sig / ".socket.sock"))
            s.sendall(b"cursorpos")
            out = s.recv(64).decode("ascii", "ignore")
        x, y = (int(float(v)) for v in out.split(","))
        return [x, y]
    except (OSError, ValueError):
        return None


def process_running(names: tuple) -> bool:
    try:
        for p in os.listdir("/proc"):
            if p.isdigit():
                try:
                    if Path(f"/proc/{p}/comm").read_text().strip() in names:
                        return True
                except OSError:
                    pass
    except OSError:
        pass
    return False


def lan_route() -> dict | None:
    """The default route's gateway, interface and the local network (only private IPv4 networks)."""
    r = json.loads(subprocess.run(["ip", "-j", "-4", "route", "show", "default"], capture_output=True,
                                  timeout=5).stdout or b"[]")
    if not r or not r[0].get("gateway"):
        return None
    gw, dev = r[0]["gateway"], r[0].get("dev", "")
    addrs = json.loads(subprocess.run(["ip", "-j", "-4", "addr", "show", "dev", dev], capture_output=True,
                                      timeout=5).stdout or b"[]")
    for a in (addrs[0].get("addr_info") if addrs else []) or []:
        try:
            net = ipaddress.ip_network(f"{a['local']}/{a['prefixlen']}", strict=False)
        except (KeyError, ValueError):
            continue
        if net.is_private and ipaddress.ip_address(gw) in net:
            return {"gw": gw, "dev": dev, "src": a["local"], "prefix": a["prefixlen"], "cidr": str(net)}
    return None


def reverse_name(ip: str) -> str:
    try:
        n = socket.gethostbyaddr(ip)[0]
    except (OSError, UnicodeError):
        return ""
    n = n.split(".")[0]
    return "" if not n or n.replace("-", "").isdigit() or n == ip.split(".")[0] else n[:20]


def in_quiet_hours(spec: str, now: float | None = None) -> bool:
    m = re.match(r"^\s*(\d{1,2}):(\d{2})\s*-\s*(\d{1,2}):(\d{2})\s*$", spec or "")
    if not m:
        return False
    lt = time.localtime(now if now is not None else time.time())
    cur = lt.tm_hour * 60 + lt.tm_min
    a, b = int(m[1]) * 60 + int(m[2]), int(m[3]) * 60 + int(m[4])
    return a <= cur < b if a <= b else cur >= a or cur < b


def voice_model(v: dict) -> str | None:
    m = str(v.get("model") or "")
    if m:
        p = Path(m).expanduser()
        return str(p) if p.is_file() else None
    d = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "piper"
    found = sorted(d.glob("*.onnx")) if d.is_dir() else []
    return str(found[0]) if found else None


def piper_tts() -> str | None:
    """piper-tts (AUR) or pip's `piper`; not the mouse tool also called piper."""
    if shutil.which("piper-tts"):
        return shutil.which("piper-tts")
    p = shutil.which("piper")
    try:
        return p if p and "piper.__main__" in Path(p).read_text(errors="ignore")[:2000] else None
    except OSError:
        return None


def speak(text: str, v: dict) -> None:
    """One line, aloud. A `command` of your own gets the text on stdin; else piper, else espeak-ng."""
    if v.get("command"):
        subprocess.run(["bash", "-c", str(v["command"])], input=text.encode(), timeout=60,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    piper = piper_tts()
    model = voice_model(v)
    player = next(([p] for p in ("pw-play", "paplay", "aplay") if shutil.which(p)), None)
    if piper and model and player:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        wav = STATE_DIR / "voice.wav"
        subprocess.run([piper, "--model", model, "--output_file", str(wav)], input=text.encode(), timeout=60,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        subprocess.run(player + [str(wav)], timeout=60, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    if shutil.which("espeak-ng"):
        subprocess.run(["espeak-ng", "-s", "165", text], timeout=60, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
        return
    log("voice: " + ("no audio player (pw-play, paplay or aplay)" if piper and model else
                     "install piper-tts and a voice in ~/.local/share/piper/, or espeak-ng"))


def hypr_socket() -> str | None:
    env = hypr_env()
    rt = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    sig = env.get("HYPRLAND_INSTANCE_SIGNATURE")
    if not sig:
        return None
    p = Path(rt) / "hypr" / sig / ".socket2.sock"
    return str(p) if p.exists() else None


# ---------------------------------------------------------------- HTTP (127.0.0.1 only)

def make_handler(hub: Hub, tok: str, port: int):
    hosts = {f"127.0.0.1:{port}", f"localhost:{port}"}
    types = {".html": "text/html; charset=utf-8", ".js": "text/javascript; charset=utf-8",
             ".css": "text/css; charset=utf-8", ".svg": "image/svg+xml", ".ttf": "font/ttf", ".png": "image/png"}

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, code: int, body: bytes, ctype: str = "application/json", cache: bool = False) -> None:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "max-age=3600" if cache else "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            self.wfile.write(body)

        def _ok(self) -> bool:
            if self.headers.get("Host") not in hosts:   # DNS rebinding: only our own address
                self._send(403, b'{"error":"host"}')
                return False
            return True

        def _authed(self, q: dict) -> bool:
            got = self.headers.get("X-Pulse-Token") or q.get("token", "")
            if not secrets.compare_digest(str(got), tok):
                self._send(401, b'{"error":"token"}')
                return False
            return True

        def do_GET(self):
            if not self._ok():
                return
            u = urllib.parse.urlsplit(self.path)
            q = dict(urllib.parse.parse_qsl(u.query))
            path = u.path
            if path == "/api/visibility":
                if self._authed(q):
                    with hub.lock:
                        data = {"mons": hub.mons,
                                "pause_when_covered": hub.conf("pulse", "pause_when_covered", default=True)}
                        body = json.dumps(data, separators=(",", ":")).encode()
                    self._send(200, body)
                return
            if path == "/api/live":   # music bars and effects, as they happen (server-sent events)
                if not self._authed(q):
                    return
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.send_header("Cache-Control", "no-store")
                self.end_headers()
                last_fx = hub.fx_seq if q.get("fx", "-1") == "-1" else int(q.get("fx", "0") or 0)
                sent, cur = 0.0, None
                with hub.lock:
                    hub.live_clients += 1
                try:
                    while True:
                        now = time.time()
                        audio = hub.audio if now - hub.audio_t < 0.5 else None
                        with hub.lock:
                            fx = [f for f in hub.fx if f["seq"] > last_fx]
                        if fx:
                            last_fx = fx[-1]["seq"]
                        c = hub.cursor if hub.cursor != cur else None
                        if audio is not None or fx or c or now - sent > 2:
                            msg = {"a": audio, "fx": fx}
                            if c:
                                msg["c"] = cur = c
                            self.wfile.write(b"data: " + json.dumps(msg, separators=(",", ":")).encode() + b"\n\n")
                            self.wfile.flush()
                            sent = now
                        time.sleep(0.05 if audio is not None else 0.2)
                except OSError:
                    return
                finally:
                    with hub.lock:
                        hub.live_clients -= 1
            if path == "/api/state":
                if self._authed(q):
                    self._send(200, json.dumps(hub.state(), separators=(",", ":")).encode())
                return
            if path.startswith("/img/"):
                if not self._authed(q):
                    return
                if hub.privacy():
                    self._send(204, b"")
                    return
                img = hub.images.get(urllib.parse.unquote(path[5:]))
                if not img:
                    self._send(404, b"{}")
                    return
                self._send(200, img[0], img[1])
                return
            name = "index.html" if path in ("/", "") else path.lstrip("/")
            f = (WEB / name).resolve()
            if WEB.resolve() not in f.parents or not f.is_file():
                self._send(404, b"{}")
                return
            self._send(200, f.read_bytes(), types.get(f.suffix, "application/octet-stream"), cache=f.suffix == ".ttf")

        def do_POST(self):
            if not self._ok():
                return
            u = urllib.parse.urlsplit(self.path)
            q = dict(urllib.parse.parse_qsl(u.query))
            if not self._authed(q):
                return
            n = int(self.headers.get("Content-Length") or 0)
            if n < 0 or n > 8_000_000:
                self._send(413, b"{}")
                return
            body = self.rfile.read(n)
            if u.path.startswith("/api/push/"):
                q["_ctype"] = self.headers.get("Content-Type", "")
                hub.push(urllib.parse.unquote(u.path[10:]), body, q)
                self._send(200, b'{"ok":true}')
            elif u.path == "/api/privacy":
                v = body.decode().strip()
                hub.privacy_manual = {"on": True, "off": False, "auto": None}.get(v, not hub.privacy())
                self._send(200, json.dumps({"privacy": hub.privacy()}).encode())
            elif u.path == "/api/reload":
                hub.reload(force=True)
                self._send(200, b'{"ok":true}')
            elif u.path.startswith("/api/agent/"):
                hub.set_agent(urllib.parse.unquote(u.path[11:]), q.get("state", "working"),
                              q.get("text") or body.decode("utf-8", "replace").strip())
                self._send(200, b'{"ok":true}')
            elif u.path == "/api/fx":
                hub.add_fx(re.sub(r"[^a-z]", "", q.get("kind", "fireworks"))[:20] or "fireworks",
                           q.get("text") or body.decode("utf-8", "replace").strip())
                self._send(200, b'{"ok":true}')
            elif u.path == "/api/focus":
                v = body.decode().strip() or q.get("minutes", "")
                try:
                    mins = 0.0 if v in ("off", "stop", "0", "") else float(v)
                except ValueError:
                    mins = 0.0
                hub.set_focus(mins, q.get("label", ""))
                self._send(200, json.dumps({"focus": hub.focus}).encode())
            elif u.path == "/api/presence":
                v = body.decode().strip() or q.get("state", "")
                hub.set_away(v in ("away", "on", "idle"), "you")
                self._send(200, json.dumps({"away": bool(hub.away)}).encode())
            elif u.path == "/api/say":
                hub.say(q.get("text") or body.decode("utf-8", "replace").strip(), force=True)
                self._send(200, b'{"ok":true}')
            elif u.path.startswith("/api/click/"):
                ok = hub.click(urllib.parse.unquote(u.path[11:]))
                self._send(200 if ok else 404, b'{"ok":true}' if ok else b"{}")
            else:
                self._send(404, b"{}")
    return H


def serve(hub: Hub, port: int) -> ThreadingHTTPServer:
    srv = ThreadingHTTPServer(("127.0.0.1", port), make_handler(hub, token(), port))
    srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv


# ---------------------------------------------------------------- the wallpaper window (GTK3 + layer shell + WebKit)

def run_wall(url: str, gpu: str = "auto") -> int:
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("GtkLayerShell", "0.1")
        try:
            gi.require_version("WebKit2", "4.1")
        except ValueError:
            gi.require_version("WebKit2", "4.0")
        from gi.repository import Gdk, GLib, Gtk, GtkLayerShell, WebKit2
    except Exception as e:   # noqa: BLE001
        log(f"missing dependencies ({e}): run extras/install-live again")
        return 77
    if not GtkLayerShell.is_supported():
        log("this session does not support the layer shell (not Wayland/Hyprland?)")
        return 1
    disp = Gdk.Display.get_default()
    wins = []
    ctx = WebKit2.WebContext.get_default()
    try:
        ctx.set_cache_model(WebKit2.CacheModel.DOCUMENT_VIEWER)
    except Exception:   # noqa: BLE001
        pass
    for i in range(disp.get_n_monitors()):
        mon = disp.get_monitor(i)
        g = mon.get_geometry()
        win = Gtk.Window()
        GtkLayerShell.init_for_window(win)
        GtkLayerShell.set_namespace(win, "omarchy-pulse")
        GtkLayerShell.set_layer(win, GtkLayerShell.Layer.BOTTOM)   # above the still wallpaper, below every window
        GtkLayerShell.set_monitor(win, mon)
        for e in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(win, e, True)
        GtkLayerShell.set_exclusive_zone(win, -1)
        try:
            GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.NONE)
        except Exception:   # noqa: BLE001
            GtkLayerShell.set_keyboard_interactivity(win, False)
        wv = WebKit2.WebView()
        wv.set_background_color(Gdk.RGBA(0.02, 0.03, 0.06, 1))
        st = wv.get_settings()
        st.set_enable_developer_extras(False)
        # gpu = "auto" (WebKit decides; no GPU device -> CPU drawing, cheaper than a software GL), "always", "never"
        try:
            pol = (os.environ.get("PULSE_GPU") or gpu or "auto").upper()
            if pol == "AUTO" and not list(Path("/dev/dri").glob("renderD*")):
                pol = "NEVER"
            if pol in ("ALWAYS", "NEVER"):
                st.set_hardware_acceleration_policy(getattr(WebKit2.HardwareAccelerationPolicy, pol))
        except Exception:   # noqa: BLE001
            pass
        wv.connect("context-menu", lambda *a: True)
        wv.load_uri(f"{url}&mx={g.x}&my={g.y}&mon={i}&primary={1 if i == 0 else 0}" + os.environ.get("PULSE_URL_EXTRA", ""))

        def crashed(view, *a):   # the web process died: load the page again
            GLib.timeout_add_seconds(2, lambda: (view.reload(), False)[1])
            return True
        wv.connect("web-process-terminated", crashed)
        win.add(wv)
        win.show_all()
        wins.append(win)

    def monitors_changed(*a):
        log("monitors changed: restarting")
        Gtk.main_quit()
    disp.connect("monitor-added", monitors_changed)
    disp.connect("monitor-removed", monitors_changed)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, Gtk.main_quit)
    Gtk.main()
    return 1   # the unit starts it again (a monitor came or went)


