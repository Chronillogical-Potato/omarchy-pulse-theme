    # -- config
    def conf(self, *keys, default=None):
        d = self.cfg
        for k in keys:
            if not isinstance(d, dict) or k not in d:
                return default
            d = d[k]
        return d

    def reload(self, force: bool = False) -> None:
        try:
            m = CONF.stat().st_mtime
        except FileNotFoundError:
            m = 0
        if not force and m == self.cfg_mtime and self.cfg:
            return
        self.cfg_mtime = m
        cfg = load_config()
        with self.lock:
            self.cfg = cfg
            self.gen += 1
            gen = self.gen
            for p in self.procs:
                try:
                    p.terminate()
                except Exception:   # noqa: BLE001
                    pass
            self.procs = []
            keep = BUILTIN_IDS
            names = {str(s.get("name", "")) for s in cfg.get("source", []) if isinstance(s, dict)}
            for k in list(self.widgets):
                if k not in keep and k not in names and not self.widgets[k].get("pushed"):
                    del self.widgets[k]
        if cfg.get("_error"):
            self.set_widget("pulse.toml", title="pulse.toml", type="text", slot="center", level="crit",
                            data={"text": "Config error: " + cfg["_error"]})
        else:
            self.drop_widget("pulse.toml")
        if self.demo:
            return
        for i, src in enumerate(cfg.get("source", [])):
            if not isinstance(src, dict) or not src.get("name") or src.get("enabled") is False:
                continue
            src = dict(src)
            src["_order"] = i
            threading.Thread(target=self.run_source, args=(src, gen), daemon=True).start()
        log(f"config loaded: {len([s for s in cfg.get('source', []) if isinstance(s, dict)])} sources")

    # -- widgets
    def set_widget(self, wid: str, **f) -> None:
        notify = None
        with self.lock:
            w = self.widgets.get(wid) or {"id": wid, "title": wid, "type": "text", "slot": "auto", "data": {}}
            old = w.get("level")
            w.update({k: v for k, v in f.items() if v is not None})
            w["updated"] = time.time()
            if f.get("error") is None:
                w.pop("error", None)
            d = w.get("data") or {}
            if w.get("type") in ("stat", "gauge") and isinstance(d.get("value"), (int, float)):
                h = w.setdefault("_hist", collections.deque(maxlen=HIST))
                h.append(d["value"])
                d["history"] = list(h)
                rules = w.get("_rules") or {}
                lv = None
                for name, lvl, cmp in (("crit_above", "crit", 1), ("crit_below", "crit", -1),
                                       ("warn_above", "warn", 1), ("warn_below", "warn", -1)):
                    if name in rules and lv is None:
                        if (cmp > 0 and d["value"] > rules[name]) or (cmp < 0 and d["value"] < rules[name]):
                            lv = lvl
                if rules:
                    w["level"] = lv or "ok"
            new = w.get("level")
            if old in ("warn", "crit") and new == "ok" and self.conf("pulse", "celebrate", default=True) is not False:
                self.add_fx("burst", f"{w.get('title', wid)} · ok", small=True)   # back to green: a small burst
            if new in ("warn", "crit") and new != old:
                self.alert_seq += 1
                txt = ""
                if isinstance(d.get("value"), (int, float)):
                    txt = f"{d['value']:g} {d.get('unit', '')}".strip()
                elif d.get("text"):
                    txt = str(d["text"]).splitlines()[0][:120]
                elif d.get("items"):
                    bad = [i for i in d["items"] if i.get("level") in ("warn", "crit")]
                    txt = ", ".join(i.get("title", "") for i in (bad or d["items"])[:4])
                elif d.get("note"):
                    txt = d["note"]
                self.alerts.append({"seq": self.alert_seq, "id": wid, "title": w.get("title", wid), "text": txt,
                                    "level": new, "t": time.time()})
                self.note("alert", f"{w.get('title', wid)}" + (f" · {txt}" if txt else ""), new, bool(w.get("private")))
                if not w.get("private"):
                    self.say(f"Alert. {w.get('title', wid)}. {txt}", "alerts")
                if w.get("_notify"):
                    notify = (w.get("title", wid), txt, new)
            self.widgets[wid] = w
        if notify and shutil.which("notify-send"):
            subprocess.Popen(["notify-send", "-u", "critical" if notify[2] == "crit" else "normal",
                              "Pulse · " + notify[0], notify[1]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def raise_alert(self, wid: str, title: str, text: str, level: str, speak: bool = True) -> None:
        with self.lock:
            self.alert_seq += 1
            self.alerts.append({"seq": self.alert_seq, "id": wid, "title": title, "text": text, "level": level,
                                "t": time.time()})
        self.note("alert", f"{title}" + (f" · {text}" if text else ""), level)
        if speak:
            self.say(f"{title}. {text}", "alerts")

    def note(self, kind: str, text: str, level: str = "info", private: bool = False) -> None:
        """While you are away, remember what happened for the digest."""
        with self.lock:
            a = self.away
            if not a:
                return
            ev = a["events"]
            if any(e["text"] == text for e in ev[-6:]):
                return
            if len(ev) < 40:
                ev.append({"kind": kind, "text": str(text)[:90], "level": level, "t": time.time(), "private": private})

    # -- effects, agents, focus
    def add_fx(self, kind: str, text: str = "", small: bool = False) -> None:
        with self.lock:
            self.fx_seq += 1
            self.fx.append({"seq": self.fx_seq, "kind": kind, "text": str(text or "")[:60], "small": small,
                            "t": time.time()})

    def set_agent(self, name: str, state: str, text: str = "") -> None:
        name = re.sub(r"[^\w.:@\- ·]", "", str(name or ""))[:32].strip() or "agent"
        st = str(state or "").lower()
        st = {"thinking": "working", "busy": "working", "run": "working", "running": "working", "start": "working",
              "started": "working", "input": "waiting", "ask": "waiting", "permission": "waiting", "blocked": "waiting",
              "ok": "done", "success": "done", "finished": "done", "complete": "done", "error": "failed",
              "fail": "failed", "stop": "gone", "end": "gone", "exit": "gone", "remove": "gone"}.get(st, st)
        now = time.time()
        with self.lock:
            if st == "gone":
                if self.agents.pop(name, None):
                    self.crew_send({"ev": "agent", "agent": name, "state": "gone"})
                return
            if st not in AGENT_STATES:
                st = "working"
            a = self.agents.get(name) or {"name": name, "since": now}
            prev = a.get("state")
            if st == "working" and prev != "working":
                a["since"] = now
            a.update(state=st, text=str(text or "")[:80], t=now)
            self.agents[name] = a
        if st == prev:
            return
        self.crew_send({"ev": "agent", "agent": name, "state": st})
        spoken = name.replace("·", ",")
        if st == "done":
            self.note("agent", f"{name} finished", "ok")
            self.say(f"{spoken} finished.", "agents")
            if self.conf("pulse", "celebrate", default=True) is not False:
                self.add_fx("fireworks", f"{name} · done", small=True)
        elif st == "waiting":
            self.say(f"{spoken} needs you.", "agents")
        elif st == "failed":
            self.raise_alert("agent:" + name, f"{name} failed", text or "the agent stopped with an error", "warn",
                             speak=False)
            self.say(f"{spoken} failed.", "agents")

    def expire_agents(self) -> None:
        now = time.time()
        with self.lock:
            for n, a in list(self.agents.items()):
                age = now - a.get("t", now)
                if (a["state"] in ("done", "failed") and age > 90) or (a["state"] == "idle" and age > 600) or age > 3600:
                    del self.agents[n]
            for n, a in list(self.crew_agents.items()):
                age = now - a.get("t", now)
                if (a["state"] in ("done", "failed") and age > 90) or age > 3600:
                    del self.crew_agents[n]

    def set_focus(self, minutes: float, label: str = "") -> None:
        with self.lock:
            if minutes <= 0:
                self.focus = None
                return
            now = time.time()
            self.focus = {"start": now, "until": now + minutes * 60, "label": str(label or "focus")[:40]}

    def check_focus(self) -> None:
        f = self.focus
        if f and time.time() >= f["until"]:
            self.focus = None
            self.add_fx("fireworks", f"{f['label']} · done")
            self.say(f"Focus done: {f['label']}.", "focus")
            if shutil.which("notify-send"):
                subprocess.Popen(["notify-send", "Pulse", f"{f['label']}: done"], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL)

    def click(self, wid: str) -> bool:
        src = next((s for s in self.cfg.get("source", []) if isinstance(s, dict) and s.get("name") == wid), None)
        cmd = (src or {}).get("click")
        if not cmd:
            return False
        subprocess.Popen(["bash", "-c", cmd], env=self.src_env(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return True

    # -- music: cava listens while something plays, the scene dances
    def loop_music(self) -> None:
        p = None
        while True:
            try:
                want = self.conf("music", "enabled", default="auto")
                playing = ((self.widgets.get("media") or {}).get("data") or {}).get("status") == "Playing"
                run = bool(shutil.which("cava")) and want not in (False, "off") and (playing or want in (True, "always"))
                if p is not None and p.poll() is not None:
                    p = None
                if run and p is None:
                    STATE_DIR.mkdir(parents=True, exist_ok=True)
                    cf = STATE_DIR / "cava.conf"
                    cf.write_text(CAVA_CONF.format(bars=int(self.conf("music", "bars", default=24)),
                                                   method=str(self.conf("music", "input", default="pulse"))))
                    p = subprocess.Popen(["cava", "-p", str(cf)], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                         start_new_session=True)
                    threading.Thread(target=self.read_cava, args=(p,), daemon=True).start()
                elif not run and p is not None:
                    p.terminate()
                    p = None
                    self.audio = []
            except Exception as e:   # noqa: BLE001
                log(f"music: {e}")
            time.sleep(2)

    def read_cava(self, p) -> None:
        for line in p.stdout:
            try:
                vals = [int(v) for v in line.decode("ascii", "ignore").strip().strip(";").split(";") if v]
            except ValueError:
                continue
            if vals:
                self.audio = vals
                self.audio_t = time.time()

    # -- presence: the face follows your pointer, sleeps when you leave, tells you what you missed
    def set_away(self, on: bool, why: str = "") -> None:
        with self.lock:
            if on:
                if not self.away:
                    self.away = {"since": time.time(), "why": why or "away", "events": []}
                    log(f"away ({why or 'away'})")
                return
            if not self.away:
                return
            a, self.away = self.away, None
        log("back")
        self.make_digest(a)

    def make_digest(self, a: dict) -> None:
        now = time.time()
        mins = (now - a["since"]) / 60
        if self.demo:   # the demo video shows a longer absence than it records
            mins += float(os.environ.get("PULSE_DEMO_AWAY", "0") or 0)
        if mins < float(self.conf("presence", "digest_after", default=2) or 0):
            return
        lines = [{"text": e["text"], "level": e["level"], "kind": e["kind"], "private": e.get("private", False)}
                 for e in a["events"]]
        with self.lock:
            news = (self.widgets.get("news") or {}).get("data") or {}
            fresh = [i for i in news.get("items") or [] if isinstance(i, dict) and (i.get("t") or 0) > a["since"]]
            notes = (self.widgets.get("notifications") or {}).get("data") or {}
            nn = [i for i in notes.get("items") or [] if isinstance(i, dict) and (i.get("t") or 0) > a["since"]]
        if fresh:
            lines.append({"kind": "news", "level": "info", "text": f"{len(fresh)} new post{'s' * (len(fresh) > 1)} · "
                          + str(fresh[0].get("title", ""))[:60]})
        if nn:
            lines.append({"kind": "notifications", "level": "info", "private": True,
                          "text": f"{len(nn)} notification{'s' * (len(nn) > 1)}"})
        with self.lock:
            self.digest_seq += 1
            self.digest = {"seq": self.digest_seq, "since": a["since"], "until": now, "mins": round(mins),
                           "lines": lines[:8], "more": max(0, len(lines) - 8)}
        h, m = divmod(round(mins), 60)
        dur = (f"{h} hour{'s' * (h > 1)} " if h else "") + (f"{m} minute{'s' * (m != 1)}" if m or not h else "")
        if lines:
            said = "; ".join((x["text"].split(" · ")[0] if x["kind"] == "alert" else x["text"].replace("·", ","))
                             for x in lines[:4] if not x.get("private"))   # alerts: only their title, aloud
            self.say(f"Welcome back. While you were away, {dur}: {said or 'some notifications'}.", "digest")
            if self.conf("presence", "notify", default=True) is not False and shutil.which("notify-send"):
                subprocess.Popen(["notify-send", f"Pulse · while you were away ({dur})",
                                  "\n".join(x["text"] for x in lines[:6])],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            self.say(f"Welcome back. All quiet for {dur}.", "digest")

    def loop_presence(self) -> None:
        """The pointer (for the eyes, a few times a second while a wallpaper listens) and the lock screen."""
        last_lock = 0.0
        while True:
            try:
                now = time.time()
                if now - last_lock > 4:
                    last_lock = now
                    locked = process_running(("hyprlock", "swaylock", "gtklock"))
                    if locked != self.locked:
                        self.locked = locked
                        if self.conf("presence", "lock", default=True) is not False:
                            if locked:
                                self.set_away(True, "locked")
                            elif self.away and self.away.get("why") in ("locked", "screensaver"):
                                self.set_away(False)
                face = self.conf("pulse", "face", default="agents") != "off"
                if self.live_clients and face and self.conf("presence", "eyes", default=True) is not False:
                    c = hypr_cursor()
                    if c and c != self.cursor:
                        self.cursor, self.cursor_t = c, now
                    time.sleep(0.2)
                else:
                    time.sleep(1)
            except Exception as e:   # noqa: BLE001
                log(f"presence: {e}")
                time.sleep(5)

    # -- your network: every device is a car on the grid; a new one is an alert
    def loop_lan(self) -> None:
        state_file = STATE_DIR / "lan.json"
        try:
            known = json.loads(state_file.read_text())
        except Exception:   # noqa: BLE001
            known = {}
        names: dict = {}
        last_scan = 0.0
        while True:
            want = self.conf("lan", "enabled", default=True)
            if want in (False, "off") or not shutil.which("ip"):
                with self.lock:
                    self.lan = {"devices": [], "net": ""}
                time.sleep(30)
                continue
            try:
                now = time.time()
                route = lan_route()
                if not route:
                    with self.lock:
                        self.lan = {"devices": [], "net": ""}
                    time.sleep(30)
                    continue
                can_scan = (self.conf("lan", "scan", default="auto") not in (False, "off") and bool(shutil.which("fping"))
                            and route["prefix"] >= 22)
                scanned = False
                if can_scan and now - last_scan > 300:
                    last_scan = now
                    subprocess.run(["fping", "-a", "-q", "-r", "0", "-t", "150", "-g", route["cidr"]],
                                   capture_output=True, timeout=60)
                    scanned = True
                neigh = json.loads(subprocess.run(["ip", "-j", "-4", "neigh", "show", "dev", route["dev"]],
                                                  capture_output=True, timeout=5).stdout or b"[]")
                cfg_names = {str(k).lower(): str(v)[:20] for k, v in (self.conf("lan", "names", default={}) or {}).items()}
                gw_mac = next((n.get("lladdr", "") for n in neigh if n.get("dst") == route["gw"]), "")
                net = gw_mac or route["gw"]
                seen = known.setdefault(net, {})
                # learning: the first 10 minutes on a network, and its first full scan, are the baseline (no alerts)
                meta = known.setdefault("_meta", {}).setdefault(net, {"first": now, "scanned": False})
                learning = now - meta["first"] < 600 or (can_scan and not meta["scanned"])
                devices, new = [], []
                for n in neigh:
                    ip, mac = n.get("dst", ""), str(n.get("lladdr", "")).lower()
                    st = n.get("state") or []
                    if not mac or not ip or ip == route["src"] or any(x in st for x in ("FAILED", "INCOMPLETE", "NOARP")):
                        continue
                    try:
                        if not ipaddress.ip_address(ip).is_private:
                            continue
                    except ValueError:
                        continue
                    d = seen.get(mac)
                    if d is None:
                        d = seen[mac] = {"first": now}
                        if learning:
                            d["base"] = True
                        else:
                            new.append(ip)
                    d.update(last=now, ip=ip)
                    if ip not in names and ip != route["gw"]:
                        names[ip] = ""
                        threading.Thread(target=lambda i=ip: names.__setitem__(i, reverse_name(i)), daemon=True).start()
                    name = cfg_names.get(mac) or cfg_names.get(ip) or ("router" if ip == route["gw"] else names.get(ip, ""))
                    devices.append({"ip": ip, "name": name, "new": now - d["first"] < 900 and not d.get("base"),
                                    "id": zlib.crc32(mac.encode()) % 100000})
                if scanned:
                    meta["scanned"] = True
                if len(seen) > 400:   # forget the oldest
                    for k in sorted(seen, key=lambda k: seen[k].get("last", 0))[:len(seen) - 400]:
                        del seen[k]
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                state_file.write_text(json.dumps(known))
                devices.sort(key=lambda d: tuple(int(p) for p in d["ip"].split(".")))
                with self.lock:
                    self.lan = {"devices": devices[:24], "net": route["cidr"]}
                if self.conf("lan", "alert_new", default=True) is not False:
                    for ip in new:
                        nm = cfg_names.get(ip) or names.get(ip) or ""
                        self.raise_alert("lan", "new device on your network", f"{ip}" + (f" · {nm}" if nm else ""),
                                         "warn", speak=False)
                        self.say("A new device joined your network.", "alerts")
                        if shutil.which("notify-send"):
                            subprocess.Popen(["notify-send", "Pulse · new device on your network", ip],
                                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception as e:   # noqa: BLE001
                log(f"lan: {e}")
            time.sleep(max(15, int(self.conf("lan", "every", default=60) or 60)))

    # -- the voice: piper (offline, natural) or espeak-ng; off unless you turn it on
    def say(self, text: str, why: str = "", force: bool = False) -> None:
        v = self.conf("voice", default={}) or {}
        if not force:
            if v.get("enabled") not in (True, "on") or self.demo:
                return
            if why and why not in (v.get("events") or ["alerts", "agents", "digest", "focus", "space"]):
                return
            if self.away or self.focus or in_quiet_hours(str(v.get("quiet", "23:00-08:00") or "")):
                return
        if self.privacy():   # sharing the screen: nothing is read aloud
            return
        if self.demo and os.environ.get("PULSE_DEMO_SPEAK_SCALE"):   # the demo video: the face talks, the audio is added later
            self.speaking = True
            secs = len(text) / 15 * float(os.environ["PULSE_DEMO_SPEAK_SCALE"])   # about 15 characters a second
            threading.Timer(secs, lambda: setattr(self, "speaking", False)).start()
            return
        try:
            self.voice_q.put_nowait(re.sub(r"\s+", " ", str(text))[:240])
        except queue.Full:
            pass

    def loop_voice(self) -> None:
        while True:
            text = self.voice_q.get()
            self.speaking = True
            try:
                speak(text, self.conf("voice", default={}) or {})
            except Exception as e:   # noqa: BLE001
                log(f"voice: {e}")
            finally:
                self.speaking = False

    # -- frame pacing: each page reports every 5 s; a monitor whose frames are slow to reach the screen is logged
    def set_perf(self, d: dict) -> None:
        if not isinstance(d, dict):
            return
        num = lambda k: float(d.get(k) or 0) if isinstance(d.get(k), (int, float)) else 0.0
        mon = re.sub(r"[^0-9,\-]", "", str(d.get("mon", "")))[:24] or "?"
        p = {"fps": num("fps"), "want": num("want"), "cap": num("cap"), "draw": num("draw"), "gap": num("gap"),
             "maxGap": num("maxGap"), "bound": bool(d.get("bound")), "w": int(num("w")), "h": int(num("h")),
             "scene": re.sub(r"[^a-z]", "", str(d.get("scene", "")))[:12], "t": time.time()}
        with self.lock:
            m = self.mons.get(mon) or {}
            p["name"] = m.get("name", "")
            self.perf[mon] = p
            last = self.perf_logged.get(mon, 0)
            if not p["bound"] or time.time() - last < 600:
                return
            self.perf_logged[mon] = time.time()
        log(perf_hint(p, self.conf("pulse", "dmabuf", default="auto")))

    # -- the Git city: every repository is a tower; it grows with this week's commits, a push lights it up
    def git_repos(self) -> list:
        g = self.conf("git", default={}) or {}
        if g.get("enabled") is False:
            return []
        paths = [Path(str(p)).expanduser() for p in (g.get("repos") or [])]
        if not paths:
            root = g.get("root", "auto")
            roots = ([Path(str(root)).expanduser()] if root not in ("auto", "", None) else
                     [HOME / d for d in ("code", "src", "projects", "Projects", "dev", "git", "repos", "work", "Work")])
            for r in roots:
                try:
                    for d in sorted(r.iterdir()) if r.is_dir() else []:
                        if (d / ".git").exists():
                            paths.append(d)
                        elif d.is_dir() and not d.name.startswith("."):
                            paths += [e for e in sorted(d.iterdir()) if (e / ".git").exists()]
                except OSError:
                    pass
        return [p for p in paths if (p / ".git").exists()][:40]

    def loop_git(self) -> None:
        prev: dict = {}
        ci_t: dict = {}
        while True:
            g = self.conf("git", default={}) or {}
            try:
                repos = self.git_repos() if shutil.which("git") else []
                out = []
                use_ci = g.get("ci", "auto") not in (False, "off") and bool(shutil.which("gh"))
                for path in repos:
                    info = git_info(path)
                    if not info:
                        continue
                    key, name = str(path), path.name[:24]
                    p = prev.get(key)
                    if p and info["up"] and p["up"] and info["up"] != p["up"] and info["head"] == info["up"] == p["head"]:
                        self.add_fx("push", f"{name} · pushed", small=True)
                        self.note("git", f"{name} pushed", "ok")
                    elif p and info["head"] != p["head"]:
                        self.add_fx("commit", name, small=True)
                    ci = (p or {}).get("ci", "")
                    slug = github_slug(info["remote"])
                    if use_ci and slug and time.time() - ci_t.get(key, 0) > 300:
                        ci_t[key] = time.time()
                        new = gh_ci(slug, info["branch"])
                        if new == "fail" and ci != "fail":
                            self.raise_alert("git:" + name, f"CI failed · {name}", info["branch"], "warn")
                        elif new == "ok" and ci == "fail":
                            self.add_fx("burst", f"{name} · CI green", small=True)
                        ci = new or ci
                    info["ci"] = ci
                    prev[key] = info
                    out.append({"name": name, "week": info["week"], "last": info["last"], "dirty": info["dirty"],
                                "ci": ci, "branch": info["branch"][:24]})
                out.sort(key=lambda r: (-r["week"], -r["last"]))
                with self.lock:
                    self.git = out[: int(g.get("max", 8) or 8)]
            except Exception as e:   # noqa: BLE001
                log(f"git: {e}")
            time.sleep(max(15, int(g.get("every", 60) or 60)))

    # -- space: the ISS when it passes over you, the aurora (Kp index), solar flares
    def loop_space(self) -> None:
        track: list = []
        kp_t = fl_t = 0.0
        last_flare, first_flare, up, warned = "", True, False, 0.0
        while True:
            sp = self.conf("space", default={}) or {}
            if sp.get("enabled") is False or self.demo:
                time.sleep(30)
                continue
            now = time.time()
            with self.lock:
                space = dict(self.space)
            try:
                if self.location and sp.get("iss", True) is not False:
                    if not track or track[-1]["timestamp"] - now < 120:
                        ts = ",".join(str(int(now + i * 60)) for i in range(10))
                        track = http_json("https://api.wheretheiss.at/v1/satellites/25544/positions?units=kilometers&timestamps=" + ts)
                    pos = iss_at(track, now)
                    if pos:
                        az, el = look_angles(self.location[0], self.location[1], pos["latitude"], pos["longitude"], pos["altitude"])
                        space["iss"] = {"az": round(az, 1), "el": round(el, 1), "alt": round(pos["altitude"]),
                                        "vel": round(pos.get("velocity", 0)), "lit": pos.get("visibility") == "daylight"} if el > 0 else None
                        if el > 10 and not up:
                            self.add_fx("iss", "ISS overhead · " + f"{pos.get('velocity', 27600):,.0f} km/h")
                            self.note("space", "the ISS passed over you", "info")
                            self.say("The International Space Station is passing over you right now.", "space")
                        up = el > 10
                if now - kp_t > 900:
                    kp_t = now
                    space["kp"] = latest_kp(http_json("https://services.swpc.noaa.gov/products/noaa-planetary-k-index.json"))
                    if (space["kp"] or 0) >= 5:
                        self.note("space", f"geomagnetic storm · Kp {space['kp']:.0f}", "info")
                if now - fl_t > 600:
                    fl_t = now
                    rows = http_json("https://services.swpc.noaa.gov/json/goes/primary/xray-flares-latest.json")
                    r = rows[-1] if isinstance(rows, list) and rows else rows if isinstance(rows, dict) else {}
                    cls, when = str(r.get("max_class") or ""), str(r.get("max_time") or "")
                    if cls[:1] in ("M", "X") and when != last_flare:
                        last_flare = when
                        space["flare"] = {"class": cls, "t": now}
                        if not first_flare:
                            self.add_fx("flare", f"solar flare · {cls}")
                            self.note("space", f"solar flare {cls}", "info")
                    first_flare = False
            except Exception as e:   # noqa: BLE001
                if now - warned > 3600:
                    warned = now
                    log(f"space: {e}")
            with self.lock:
                self.space = {**space, "launch": self.space.get("launch")}
            time.sleep(5)

    # -- rocket launches: SpaceX by default (Launch Library 2, The Space Devs); a countdown, then liftoff on your horizon
    def loop_launches(self) -> None:
        fetched, warned = 0.0, 0.0
        while True:
            sp = self.conf("space", default={}) or {}
            who = str(sp.get("launches", "spacex") or "off")
            if sp.get("enabled") is False or who in ("off", "false") or self.demo:
                self.drop_widget("launches")
                time.sleep(30)
                continue
            now = time.time()
            try:
                if now - fetched > 600:   # the free API allows 15 calls an hour
                    fetched = now
                    q = "limit=5&mode=list" + ("" if who == "all" else "&lsp__name=" + urllib.parse.quote(
                        {"spacex": "SpaceX", "rocketlab": "Rocket Lab", "blueorigin": "Blue Origin", "nasa": "National Aeronautics and Space Administration"}.get(who.lower(), who)))
                    j = http_json("https://ll.thespacedevs.com/2.3.0/launches/upcoming/?" + q)
                    self.launches = [x for x in (parse_launch(r) for r in j.get("results") or []) if x]
                ls = [x for x in self.launches if x["net"] > now - 120]
                for x in ls:   # liftoff, at T-0 (to the second when the time is known that well)
                    if x["id"] not in self.launched and x["net"] <= now < x["net"] + 90 and x["status"] in ("Go", "In Flight", "Success"):
                        self.launched.add(x["id"])
                        self.add_fx("launch", f"{x['rocket']} · {x['mission']} · liftoff")
                        self.note("space", f"{x['rocket']} {x['mission']} lifted off", "info")
                        self.say(f"Liftoff! {x['rocket']}, {x['mission']}.", "space")
                nxt = next((x for x in ls if x["net"] > now - 60), None)
                with self.lock:
                    self.space = {**self.space, "launch": nxt}
                panel = str(sp.get("launches_panel", "ticker"))
                if panel != "off" and ls:
                    self.set_widget("launches", title="launches", type="list", slot=panel if panel in ("left", "right", "center") else "ticker",
                                    order=27, icon="󱓞", data={"items": [{"title": f"{x['rocket']} · {x['mission']}",
                                    "text": countdown(x["net"] - now) + " · " + x["status"], "t": x["net"]} for x in ls[:3]]})
            except Exception as e:   # noqa: BLE001
                if now - warned > 3600:
                    warned = now
                    log(f"launches: {e}")
            time.sleep(5)

    # -- your heart: the horizon beats with it (only from a source you connect; never logged, never sent)
    def loop_heart(self) -> None:
        while True:
            h = self.conf("heart", default={}) or {}
            if h.get("enabled") is False or not (h.get("command") or h.get("url") or h.get("file")):
                self.heart = None
                time.sleep(30)
                continue
            try:
                if h.get("command"):
                    raw = subprocess.run(["bash", "-c", str(h["command"])], capture_output=True, timeout=15,
                                         env=self.src_env()).stdout.decode("utf-8", "replace")
                elif h.get("url"):
                    req = urllib.request.Request(str(h["url"]), headers={str(k): str(v) for k, v in (h.get("headers") or {}).items()})
                    with urllib.request.urlopen(req, timeout=10) as r:
                        raw = r.read(100_000).decode("utf-8", "replace")
                else:
                    raw = Path(str(h["file"])).expanduser().read_text()[:100_000]
                bpm = heart_value(raw, str(h.get("path") or ""))
                if bpm:
                    self.heart = {"bpm": bpm, "t": time.time()}
            except Exception:   # noqa: BLE001 - a heart source that fails just goes quiet (no values in the log)
                pass
            time.sleep(max(3, int(h.get("every", 10) or 10)))

    # -- the crew: friends share a code; agents and fireworks travel between your cities, sealed with that code
    def crew_send(self, payload: dict) -> None:
        code = self.crew_code
        if not code:
            return
        c = self.conf("crew", default={}) or {}
        if payload.get("ev") == "agent":
            a = str(payload.get("agent", ""))
            payload["agent"] = a if c.get("share") == "full" else a.split("·")[0].strip()
            k = payload["agent"]
            if self.crew_last.get(k) == payload["state"]:
                return
            self.crew_last[k] = payload["state"]
        payload.update(v=1, id=self.crew_id, name=str(c.get("name") or os.environ.get("USER") or "friend")[:16],
                       t=int(time.time()))
        try:
            self.crew_q.put_nowait((code, payload))
        except queue.Full:
            pass

    def loop_crew_send(self) -> None:
        """One message at a time, a little apart, again after a while if the relay says "too many" (HTTP 429)."""
        while True:
            code, payload = self.crew_q.get()
            time.sleep(0.4)   # what happens together travels together: one message, fewer requests
            batch = [payload]
            while len(batch) < 10:
                try:
                    c2, p2 = self.crew_q.get_nowait()
                except queue.Empty:
                    break
                if c2 == code:
                    batch.append(p2)
            if len(batch) > 1:
                payload = {k: payload[k] for k in ("v", "id", "name", "t") if k in payload}
                payload["batch"] = [{k: v for k, v in b.items() if k not in ("v", "id", "name", "t")} for b in batch]
            relay = str(self.conf("crew", "relay", default="") or "https://ntfy.sh").rstrip("/")
            body = crew_seal(code, payload).encode()
            for attempt in range(5):
                try:
                    urllib.request.urlopen(urllib.request.Request(f"{relay}/{crew_topic(code)}", data=body, method="POST",
                                                                  headers={"Content-Type": "text/plain"}), timeout=10).read()
                    break
                except urllib.error.HTTPError as e:
                    if e.code != 429 or attempt == 4:
                        log(f"crew: could not send ({e})")
                        break
                    time.sleep(6 * (attempt + 1))
                except Exception as e:   # noqa: BLE001
                    log(f"crew: could not send ({e})")
                    break
            time.sleep(1.5)

    def crew_receive(self, payload: dict) -> None:
        if payload.get("id") == self.crew_id or abs(time.time() - float(payload.get("t") or 0)) > 300:
            return
        if isinstance(payload.get("batch"), list):
            for item in payload["batch"][:10]:
                if isinstance(item, dict):
                    self.crew_receive({**item, "id": payload.get("id"), "name": payload.get("name"), "t": payload.get("t")})
            return
        clean = lambda v, n: re.sub(r"[^\w.:@\- ]", "", str(v or ""))[:n].strip()
        who = clean(payload.get("name"), 16) or "friend"
        if payload.get("ev") == "agent":
            agent = clean(payload.get("agent"), 24) or "agent"
            key, st = f"{who} · {agent}", str(payload.get("state", ""))
            now = time.time()
            with self.lock:
                if st == "gone" or st not in AGENT_STATES:
                    self.crew_agents.pop(key, None)
                    return
                a = self.crew_agents.get(key) or {"name": key, "since": now, "crew": who}
                prev = a.get("state")
                a.update(state=st, text="crew", t=now)
                self.crew_agents[key] = a
            if st == "done" and prev != "done" and self.conf("pulse", "celebrate", default=True) is not False:
                self.add_fx("fireworks", f"{key} · done", small=True)
        elif payload.get("ev") == "fx":
            self.add_fx("fireworks", f"{who} · {clean(payload.get('text'), 40)}".strip(" ·"), small=True)

    def loop_crew(self) -> None:
        backoff = 5
        while True:
            c = self.conf("crew", default={}) or {}
            code = str(c.get("code") or "") if c.get("enabled") is not False else ""
            self.crew_code = code if len(code) >= 16 else ""
            if not self.crew_code or self.demo:
                self.crew_status = "off" if not code else "code too short (omarchy-pulse crew new)"
                time.sleep(10)
                continue
            relay = str(c.get("relay") or "https://ntfy.sh").rstrip("/")
            try:
                req = urllib.request.Request(f"{relay}/{crew_topic(code)}/json", headers={"User-Agent": "omarchy-pulse/" + VERSION})
                with urllib.request.urlopen(req, timeout=90) as r:
                    self.crew_status = "connected"
                    backoff = 5
                    for line in r:
                        if str(self.conf("crew", "code", default="") or "") != code:
                            break   # the code changed: start again
                        try:
                            m = json.loads(line)
                            if m.get("event") == "message":
                                self.crew_receive(crew_open(code, m.get("message", "")))
                        except (ValueError, KeyError, TypeError):
                            continue   # not ours, or tampered with: ignored
            except Exception as e:   # noqa: BLE001
                self.crew_status = f"offline ({e})"
                time.sleep(backoff)
                backoff = min(120, backoff * 2)

    # -- "hey sphere": push to talk, offline speech to text, only safe commands, the answer out loud
    def listen_start(self, secs: float = 5, wav: str = "") -> bool:
        if self.listen and self.listen.get("state") in ("listening", "thinking"):
            return False
        self.listen_stop.clear()
        threading.Thread(target=self._listen, args=(max(1.0, min(15.0, secs)), wav), daemon=True).start()
        return True

    def _listen(self, secs: float, wav: str) -> None:
        conf = self.conf("listen", default={}) or {}
        tmp = None
        try:
            if not wav:
                STATE_DIR.mkdir(parents=True, exist_ok=True)
                tmp = wav = str(STATE_DIR / "listen.wav")
                rec = (["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16", wav] if shutil.which("pw-record") else
                       ["arecord", "-q", "-f", "S16_LE", "-r", "16000", "-c", "1", wav] if shutil.which("arecord") else None)
                if not rec:
                    self.listen = {"state": "answer", "heard": "", "answer": "No microphone tool: install pipewire or alsa-utils.", "t": time.time()}
                    return
                self.listen = {"state": "listening", "t": time.time()}
                p = subprocess.Popen(rec, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self.listen_stop.wait(secs)
                p.terminate()
                try:
                    p.wait(3)
                except subprocess.TimeoutExpired:
                    p.kill()
            else:   # a file: "listening" for as long as asked, then the file is understood
                self.listen = {"state": "listening", "t": time.time()}
                self.listen_stop.wait(secs)
            self.listen = {"state": "thinking", "t": time.time()}
            heard = speech_to_text(wav, conf)
            if heard is None:
                answer = "I need a speech engine: whisper.cpp or faster-whisper (see the guide)."
                heard = ""
            elif not heard.strip():
                answer = "Sorry, I didn't catch that."
            else:
                answer = self.voice_command(heard)
            self.listen = {"state": "answer", "heard": heard.strip()[:120], "answer": answer[:300], "t": time.time()}
            self.say(answer, force=True)
        except Exception as e:   # noqa: BLE001
            log(f"listen: {e}")
            self.listen = {"state": "answer", "heard": "", "answer": "Something went wrong.", "t": time.time()}
        finally:
            if tmp:
                try:
                    os.unlink(tmp)   # the recording never stays on disk
                except OSError:
                    pass

    def voice_command(self, text: str) -> str:
        t = re.sub(r"^\W*((hey|hi|ok|ehi|ei|ciao)\W+)?(sphere|sfera|pulse)\W*", "", text.lower().strip()).strip()
        it = bool(re.search(r"\b(che|come|quanti|quante|accendi|spegni|ferma|metti|fuochi|meteo|ore|sono|stato|minuti|cosa|mi|ho|il|la|per)\b|citt|^\W*ehi\b|sfera", text.lower()))
        L = lambda en, itl: itl if it else en
        if re.search(r"\b(stop|end|basta|ferma|termina|spegni)\b.*\b(focus|concentra\w*)", t):
            self.set_focus(0)
            return L("Focus off.", "Focus finito.")
        m = re.search(r"\b(focus|concentra\w*)\D{0,24}(\d{1,3})", t) or re.search(r"(\d{1,3})\s*(minutes?|minuti)\s*(of\s*)?(di\s*)?(focus|concentra\w*)", t)
        if m:
            n = max(1, min(240, int(next(g for g in m.groups() if g and g.isdigit()))))
            self.set_focus(n, "voice")
            return L(f"Focus for {n} minutes. I'll keep things quiet.", f"Focus per {n} minuti. Faccio silenzio.")
        if "privacy" in t:
            on = not re.search(r"\b(off|disattiva|spegni|togli|no)\b", t)
            self.privacy_manual = True if on else None
            return L("Privacy on." if on else "Privacy off.", "Privacy attiva." if on else "Privacy spenta.")
        if re.search(r"firework|fuochi", t):
            self.add_fx("fireworks", "hey sphere")
            return L("Fireworks!", "Fuochi d'artificio!")
        if re.search(r"\bmiss|away|\bpers[oi]|successo|novit", t):
            d = self.digest
            if not d or not d["lines"]:
                return L("Nothing happened while you were away.", "Mentre eri via non è successo niente.")
            items = "; ".join((x["text"].split(" · ")[0] if x["kind"] == "alert" else x["text"].replace("·", ","))
                              for x in d["lines"][:4] if not x.get("private"))
            return L(f"While you were away: {items}.", f"Mentre eri via: {items}.")
        if re.search(r"\biss\b|space station|stazione spaziale", t):
            iss = (self.space or {}).get("iss")
            if iss:
                return L(f"The ISS is above you right now, {iss['el']:.0f} degrees up.", f"La ISS è sopra di te adesso, a {iss['el']:.0f} gradi.")
            return L("The ISS is not over you right now. I'll tell you when it passes.", "La ISS ora non è sopra di te. Ti avviso quando passa.")
        if re.search(r"weather|meteo|tempo fa|piov|rain", t):
            w = self.weather or {}
            if w.get("temp") is None:
                return L("I have no weather yet.", "Non ho ancora il meteo.")
            return L(f"{w['temp']:.0f} degrees, feels like {w.get('feels', w['temp']):.0f}.",
                     f"{w['temp']:.0f} gradi, percepiti {w.get('feels', w['temp']):.0f}.")
        if re.search(r"time is it|what time|che or[ae]", t):
            return L("It's " + time.strftime("%H:%M") + ".", "Sono le " + time.strftime("%H:%M") + ".")
        if re.search(r"agent|agenti|claude|codex|grok|drone", t):
            with self.lock:
                ag = list(self.agents.values())
            if not ag:
                return L("No agents are working right now.", "Nessun agente sta lavorando adesso.")
            words = {"working": L("working", "lavora"), "waiting": L("needs you", "ti aspetta"), "done": L("is done", "ha finito"),
                     "failed": L("failed", "è fallito"), "idle": L("is idle", "è fermo")}
            return "; ".join(f"{a['name'].replace('·', ',')} {words.get(a['state'], a['state'])}" for a in ag[:4]) + "."
        m = re.search(r"\b(city|citta|città|skyline)[\s,:;]+(?:di\s+|of\s+)?([a-zà-ü .'-]{2,40}?)[\W]*$", t)
        if m:
            k = city_key(m.group(2).strip(" .?!"))
            if not k:
                return L(f"I can't draw {m.group(2).strip()} yet.", f"Non so ancora disegnare {m.group(2).strip()}.")
            self.skyline_override = k
            said = m.group(2).strip(" .?!").title()
            return L(f"Welcome to {said}.", f"Benvenuto a {said}.")
        m = re.search(r"\b(scene|scena)\s+(sphere|sfera|skyline|orbit|calm)", t)
        if m:
            self.scene_override = {"sfera": "sphere"}.get(m.group(2), m.group(2))
            return L(f"Scene {self.scene_override}.", f"Scena {self.scene_override}.")
        if re.search(r"server|status|stato|come (va|sta)|alert|problem|tutto bene|everything", t):
            with self.lock:
                bad = [w.get("title", w["id"]) for w in self.widgets.values() if w.get("level") in ("warn", "crit")
                       and not (w.get("private") and self.privacy())]
                n = len(self.widgets)
            if not bad:
                return L(f"Everything is fine: {n} sources, no alerts.", f"Tutto a posto: {n} sorgenti, nessun allarme.")
            return L(f"{len(bad)} need attention: " + ", ".join(bad[:4]) + ".", f"{len(bad)} da controllare: " + ", ".join(bad[:4]) + ".")
        ask = str((self.conf("listen", default={}) or {}).get("ask") or "")
        if ask:
            try:
                prompt = ("You are the voice of a live desktop wallpaper. Answer in one or two short spoken sentences, "
                          f"in the language of the question. Question: {text.strip()}")
                r = subprocess.run(["bash", "-c", ask], input=prompt.encode(), capture_output=True, timeout=60, env=self.src_env())
                out = re.sub(r"\s+", " ", r.stdout.decode("utf-8", "replace")).strip()
                if out:
                    return out[:300]
            except Exception as e:   # noqa: BLE001
                log(f"listen ask: {e}")
        return L("I can start a focus, turn privacy on, fire fireworks, and tell you the status, the weather, the time, "
                 "your agents, the ISS or what you missed.",
                 "Posso avviare un focus, attivare la privacy, lanciare fuochi d'artificio e dirti lo stato, il meteo, "
                 "l'ora, i tuoi agenti, la ISS o cosa ti sei perso.")

    def drop_widget(self, wid: str) -> None:
        with self.lock:
            self.widgets.pop(wid, None)
            self.images.pop(wid, None)

    def widget_error(self, wid: str, msg: str) -> None:
        with self.lock:
            w = self.widgets.get(wid)
            if w:
                w["error"] = re.sub(r"://[^/@\s]+@", "://***@", msg)[:200]   # never show a camera password

    def apply(self, src: dict, raw) -> None:
        p = parse_output(raw, src.get("type", "auto"))
        base = self.src_fields(src)
        if src.get("title"):
            p.pop("title", None)
        self.set_widget(src["name"], **{**base, **p, "error": None})

    @staticmethod
    def src_fields(src: dict) -> dict:
        f = {"title": src.get("title", src["name"]), "slot": src.get("slot", "auto"),
             "order": src.get("order", src.get("_order", 50)), "private": bool(src.get("private", False)),
             "icon": src.get("icon"), "size": src.get("size"),
             "_rules": {k: src[k] for k in ("warn_above", "crit_above", "warn_below", "crit_below") if k in src},
             "_notify": bool(src.get("notify", False)), "click": bool(src.get("click"))}
        if src.get("unit"):
            f["unit_override"] = src["unit"]
        return f

    # -- sources
    def alive(self, gen: int) -> bool:
        return gen == self.gen

    def run_source(self, src: dict, gen: int) -> None:
        name = src["name"]
        every = max(1.0, float(src.get("every", 30)))
        try:
            if "stream" in src:
                return self.src_stream(src, gen)
            if "camera" in src and not src.get("snapshot"):
                return self.src_camera(src, gen)
            if src.get("push"):
                self.set_widget(name, **self.src_fields(src), type=src.get("type", "text"),
                                data={"text": "waiting for: omarchy-pulse push " + name + " ..."})
                return
        except Exception as e:   # noqa: BLE001
            self.widget_error(name, str(e))
            return
        last_mtime = None
        while self.alive(gen):
            try:
                if "command" in src:
                    r = subprocess.run(["bash", "-c", src["command"]], capture_output=True, timeout=float(src.get("timeout", 60)),
                                       env=self.src_env())
                    if r.returncode != 0 and not r.stdout.strip():
                        raise RuntimeError((r.stderr.decode(errors="replace").strip() or f"exit {r.returncode}")[-200:])
                    if self.alive(gen):
                        self.apply(src, r.stdout)
                elif "url" in src or "camera" in src:
                    url = src.get("url") or src["camera"]
                    req = urllib.request.Request(url, headers={"User-Agent": "omarchy-pulse/" + VERSION,
                                                               **{k: str(v) for k, v in (src.get("headers") or {}).items()}})
                    with urllib.request.urlopen(req, timeout=float(src.get("timeout", 20))) as resp:
                        ctype = resp.headers.get("Content-Type", "")
                        body = resp.read(8_000_000)
                    if ctype.startswith("image/") or "camera" in src:
                        self.put_image(src, body, ctype or "image/jpeg")
                    else:
                        try:
                            obj = json.loads(body)
                            if src.get("path"):
                                obj = dig(obj, src["path"])
                            self.apply(src, json.dumps(obj) if not isinstance(obj, str) else obj)
                        except ValueError:
                            self.apply(src, body)
                elif "file" in src:
                    fp = Path(os.path.expanduser(src["file"]))
                    m = fp.stat().st_mtime
                    if m != last_mtime:
                        last_mtime = m
                        if fp.suffix.lower() in (".jpg", ".jpeg", ".png", ".webp", ".gif"):
                            self.put_image(src, fp.read_bytes(), "image/" + fp.suffix.lower().lstrip(".").replace("jpg", "jpeg"))
                        else:
                            self.apply(src, fp.read_bytes()[:200_000])
                    every = min(every, 2.0)
                else:
                    self.set_widget(name, **self.src_fields(src), type="text",
                                    data={"text": "no command, stream, url, file or camera"}, level="warn")
                    return
            except Exception as e:   # noqa: BLE001
                if self.alive(gen):
                    if name not in self.widgets:
                        self.set_widget(name, **self.src_fields(src), type="text", data={"text": ""})
                    self.widget_error(name, str(e))
            end = time.time() + every
            while self.alive(gen) and time.time() < end:
                time.sleep(0.5)

    def src_env(self) -> dict:
        env = dict(os.environ)
        env["PATH"] = f"{CONF_DIR / 'sources'}:{HERE / 'sources'}:{env.get('PATH', '/usr/bin')}"
        env["PULSE_THEME"] = self.theme.get("name", "")
        return env

    def put_image(self, src: dict, body: bytes, ctype: str) -> None:
        with self.lock:
            self.images[src["name"]] = (body, ctype, time.time())
        f = {**self.src_fields(src), "type": "image", "private": bool(src.get("private", True)), "error": None,
             "data": {"src": "/img/" + urllib.parse.quote(src["name"]), "live": "camera" in src}}
        self.set_widget(src["name"], **f)

    def src_stream(self, src: dict, gen: int) -> None:
        backoff = 3
        while self.alive(gen):
            try:
                p = subprocess.Popen(["bash", "-c", src["stream"]], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                     env=self.src_env(), start_new_session=True)
                with self.lock:
                    self.procs.append(p)
                acc = []
                for line in p.stdout:
                    if not self.alive(gen):
                        break
                    s = line.decode("utf-8", "replace").rstrip("\n")
                    if src.get("type") in ("list", "status") and not s.lstrip().startswith(("{", "[")):
                        acc = (acc + [s])[-int(src.get("lines", 8)):]   # a log: the last lines
                        self.apply(src, "\n".join(acc))
                    elif src.get("type") == "text" and not s.lstrip().startswith("{"):
                        acc = (acc + [s])[-int(src.get("lines", 8)):]
                        self.apply(src, "\n".join(acc))
                    else:
                        self.apply(src, s)
                    backoff = 3
                p.wait(timeout=2)
                err = p.stderr.read().decode(errors="replace").strip()[-200:] if p.stderr else ""
                if self.alive(gen):
                    self.widget_error(src["name"], err or f"stream ended (exit {p.returncode})")
            except Exception as e:   # noqa: BLE001
                if self.alive(gen):
                    self.widget_error(src["name"], str(e))
            time.sleep(backoff)
            backoff = min(backoff * 2, 60)

    def src_camera(self, src: dict, gen: int) -> None:
        """One ffmpeg per camera, kept open: a few JPEG frames a second split out of an MJPEG pipe."""
        if not shutil.which("ffmpeg"):
            self.set_widget(src["name"], **self.src_fields(src), type="image", data={}, level="warn")
            self.widget_error(src["name"], "ffmpeg is not installed")
            return
        fps = float(src.get("fps", 2))
        width = int(src.get("width", 640))
        url = src["camera"]
        backoff = 3
        while self.alive(gen):
            args = ["ffmpeg", "-nostdin", "-loglevel", "error"]
            if url.startswith(("rtsp://", "rtsps://")):
                args += ["-rtsp_transport", src.get("transport", "tcp")]
            args += ["-i", url, "-an", "-vf", f"fps={fps},scale={width}:-2", "-f", "image2pipe", "-c:v", "mjpeg",
                     "-q:v", "6", "-"]
            try:
                p = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
                with self.lock:
                    self.procs.append(p)
                buf = b""
                while self.alive(gen):
                    chunk = p.stdout.read1(65536) if hasattr(p.stdout, "read1") else p.stdout.read(65536)
                    if not chunk:
                        break
                    buf += chunk
                    while True:
                        a = buf.find(b"\xff\xd8")
                        b = buf.find(b"\xff\xd9", a + 2)
                        if a < 0 or b < 0:
                            break
                        self.put_image(src, buf[a:b + 2], "image/jpeg")
                        buf = buf[b + 2:]
                        backoff = 3
                    if len(buf) > 4_000_000:
                        buf = b""
                p.kill()
                err = p.stderr.read().decode(errors="replace").strip()[-160:]
                if self.alive(gen):
                    if src["name"] not in self.widgets:
                        self.set_widget(src["name"], **self.src_fields(src), type="image", data={})
                    self.widget_error(src["name"], err or "camera stream ended")
            except Exception as e:   # noqa: BLE001
                if self.alive(gen):
                    self.widget_error(src["name"], str(e))
            time.sleep(backoff)
            backoff = min(backoff * 2, 60)

    def push(self, name: str, body: bytes, q: dict) -> None:
        name = re.sub(r"[^\w.\- ]", "", name)[:40] or "push"
        configured = next((s for s in self.cfg.get("source", []) if isinstance(s, dict) and s.get("name") == name), None)
        src = dict(configured or {"name": name})
        if not configured:   # a panel made by an earlier push keeps its title, place and order
            old = self.widgets.get(name) or {}
            for k in ("title", "slot", "order", "icon", "private"):
                if k in old and old[k] is not None:
                    src.setdefault(k, old[k])
            if "type" in old and not q.get("type") and old["type"] not in ("text",):
                src.setdefault("type", old["type"])
        for k in ("title", "type", "slot", "level", "order"):
            if q.get(k):
                src[k] = int(q[k]) if k == "order" and str(q[k]).isdigit() else q[k]
        ctype = q.get("_ctype", "")
        if ctype.startswith("image/"):
            self.put_image(src, body, ctype)
            return
        p = parse_output(body, src.get("type", "auto"))
        if src.get("title"):
            p.pop("title", None)
        f = {**self.src_fields(src), **p, "pushed": True, "error": None}
        if q.get("level") in LEVELS:
            f["level"] = q["level"]
        self.set_widget(name, **f)

    # -- built-ins
    def builtin(self, key: str, default=True):
        return self.conf("builtin", key, default=default)

    def loop_system(self) -> None:
        prev_cpu = None
        prev_net = None
        prev_t = time.time()
        gpu_t = 0.0
        gpu = None
        while True:
            try:
                now = time.time()
                with open("/proc/stat") as f:
                    lines = [l.split() for l in f if l.startswith("cpu")]
                cur = [(sum(map(int, l[1:9])), int(l[4]) + int(l[5])) for l in lines]
                cpu, cores = 0.0, []
                if prev_cpu and len(prev_cpu) == len(cur):
                    for i, ((tot, idle), (ptot, pidle)) in enumerate(zip(cur, prev_cpu)):
                        dt = tot - ptot
                        v = 0.0 if dt <= 0 else 100.0 * (1 - (idle - pidle) / dt)
                        if i == 0:
                            cpu = v
                        else:
                            cores.append(round(v, 1))
                prev_cpu = cur
                mem = {}
                with open("/proc/meminfo") as f:
                    for l in f:
                        k, v = l.split(":", 1)
                        mem[k] = int(v.split()[0])
                tot = mem.get("MemTotal", 1)
                used = tot - mem.get("MemAvailable", tot)
                swap_t = mem.get("SwapTotal", 0)
                swap = 0 if not swap_t else 100 * (swap_t - mem.get("SwapFree", 0)) / swap_t
                rx = tx = 0
                with open("/proc/net/dev") as f:
                    for l in list(f)[2:]:
                        iface, data = l.split(":", 1)
                        if iface.strip() == "lo" or iface.strip().startswith(("veth", "docker", "br-", "virbr")):
                            continue
                        d = data.split()
                        rx += int(d[0])
                        tx += int(d[8])
                dt = max(0.5, now - prev_t)
                rxr = txr = 0.0
                if prev_net:
                    rxr = max(0, rx - prev_net[0]) / dt
                    txr = max(0, tx - prev_net[1]) / dt
                prev_net, prev_t = (rx, tx), now
                if now - gpu_t > 4:
                    gpu_t = now
                    gpu = read_gpu()
                temp = read_temp()
                du = shutil.disk_usage("/")
                with open("/proc/loadavg") as f:
                    load = f.read().split()[:3]
                with open("/proc/uptime") as f:
                    up = float(f.read().split()[0])
                bat = read_battery()
                s = {"cpu": round(cpu, 1), "cores": cores, "ram": round(100 * used / tot, 1),
                     "ramUsed": used * 1024, "ramTotal": tot * 1024, "swap": round(swap, 1), "gpu": gpu, "temp": temp,
                     "disk": round(100 * du.used / du.total, 1), "diskFree": du.free, "load": load, "uptime": up,
                     "rx": rxr, "tx": txr, "bat": bat, "ip": local_ip(), "host": socket.gethostname(),
                     "user": os.environ.get("USER", "")}
                with self.lock:
                    self.sys = s
                    for k, v in (("cpu", cpu), ("rx", rxr), ("tx", txr), ("ram", s["ram"]), ("gpu", gpu or 0),
                                 ("temp", temp or 0)):
                        self.hist[k].append(round(v, 1))
                # built-in alerts: a hot CPU, a full disk
                if temp:
                    self.edge_alert("temp", "CPU temperature", temp >= float(self.conf("pulse", "temp_crit", default=90)),
                                    f"{temp:.0f} °C")
                self.edge_alert("disk", "Disk /", s["disk"] >= 95, f"{s['disk']:.0f}% used")
            except Exception as e:   # noqa: BLE001
                log(f"system: {e}")
            time.sleep(2)

    _edges: dict = {}

    def edge_alert(self, key: str, title: str, bad: bool, text: str) -> None:
        if bad and not self._edges.get(key):
            with self.lock:
                self.alert_seq += 1
                self.alerts.append({"seq": self.alert_seq, "id": key, "title": title, "text": text, "level": "crit",
                                    "t": time.time()})
        self._edges[key] = bad

    def loop_weather(self) -> None:
        geo = None
        while True:
            wait = 900
            try:
                if self.builtin("weather") is not False:
                    lat, lon = self.conf("pulse", "latitude"), self.conf("pulse", "longitude")
                    city = str(self.conf("pulse", "city", default="") or "")
                    if lat is None and city:
                        if not geo or geo[0] != city:
                            j = http_json("https://geocoding-api.open-meteo.com/v1/search?count=1&name=" +
                                          urllib.parse.quote(city))
                            r = (j.get("results") or [None])[0]
                            geo = (city, r["latitude"], r["longitude"], r.get("name", city)) if r else (city, None, None, city)
                        _, lat, lon, label = geo
                    else:
                        label = city or (f"{lat:.2f}, {lon:.2f}" if lat is not None else "")
                    if lat is None:
                        self.weather = {"city": city, "error": "set city = \"...\" in pulse.toml" if not city else
                                        f"city not found: {city}"}
                    else:
                        self.location = (float(lat), float(lon))
                        imperial = self.conf("pulse", "units", default="metric") == "imperial"
                        q = (f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}"
                             "&current=temperature_2m,apparent_temperature,weather_code,wind_speed_10m,relative_humidity_2m,is_day,precipitation"
                             "&hourly=temperature_2m,precipitation_probability,weather_code"
                             "&daily=temperature_2m_max,temperature_2m_min,sunrise,sunset&timezone=auto&forecast_days=2")
                        if imperial:
                            q += "&temperature_unit=fahrenheit&wind_speed_unit=mph"
                        j = http_json(q)
                        cur = j["current"]
                        hours = []
                        ht = j["hourly"]["time"]
                        nowiso = cur["time"][:13]
                        start = next((i for i, t in enumerate(ht) if t[:13] >= nowiso), 0)
                        for i in range(start, min(start + 24, len(ht))):
                            hours.append({"h": ht[i][11:13], "t": j["hourly"]["temperature_2m"][i],
                                          "p": j["hourly"]["precipitation_probability"][i],
                                          "c": j["hourly"]["weather_code"][i]})
                        self.weather = {"city": label, "temp": cur["temperature_2m"], "feels": cur["apparent_temperature"],
                                        "code": cur["weather_code"], "wind": cur["wind_speed_10m"],
                                        "hum": cur["relative_humidity_2m"], "day": cur["is_day"],
                                        "rain": cur.get("precipitation", 0),
                                        "hi": j["daily"]["temperature_2m_max"][0], "lo": j["daily"]["temperature_2m_min"][0],
                                        "sunrise": j["daily"]["sunrise"][0][11:16], "sunset": j["daily"]["sunset"][0][11:16],
                                        "unit": "°F" if imperial else "°C", "windUnit": "mph" if imperial else "km/h",
                                        "hours": hours, "t": time.time()}
                else:
                    self.weather = None
            except Exception as e:   # noqa: BLE001
                log(f"weather: {e}")
                if self.weather:
                    self.weather["stale"] = True
                wait = 120
            self.sleep_or_reload(wait)

    def sleep_or_reload(self, secs: float) -> None:
        g = self.gen
        end = time.time() + secs
        while time.time() < end and self.gen == g:
            time.sleep(1)

    def loop_github(self) -> None:
        while True:
            repos = self.builtin("github", default=["basecamp/omarchy"])
            notif = self.builtin("github_notifications", default=True)
            items = []
            try:
                if isinstance(repos, str):
                    repos = [repos]
                for repo in (repos or [])[:4]:
                    rel = gh_api(f"repos/{repo}/releases?per_page=1")
                    if rel:
                        r = rel[0]
                        items.append({"title": f"{repo} · {r.get('tag_name', '')}", "text": (r.get("name") or "release")[:80],
                                      "t": iso_ts(r.get("published_at")), "level": "info"})
                    for c in (gh_api(f"repos/{repo}/commits?per_page=3") or [])[:3]:
                        msg = (c.get("commit", {}).get("message") or "").splitlines()[0][:90]
                        items.append({"title": msg, "text": repo + " · " + ((c.get("author") or {}).get("login") or ""),
                                      "t": iso_ts(c.get("commit", {}).get("author", {}).get("date"))})
                if notif and shutil.which("gh"):
                    ns = gh_api("notifications?per_page=6", auth_only=True) or []
                    for n in ns[:5]:
                        items.insert(0, {"title": n.get("subject", {}).get("title", "")[:90],
                                         "text": n.get("repository", {}).get("full_name", "") + " · " +
                                         n.get("subject", {}).get("type", ""), "t": iso_ts(n.get("updated_at")),
                                         "level": "warn" if n.get("reason") in ("review_requested", "security_alert") else "info"})
                if items:
                    self.set_widget("github", title="github", type="list", slot=self.builtin("github_slot", "right"),
                                    order=self.builtin("github_order", 30), data={"items": items[:8]}, icon="")
                else:
                    self.drop_widget("github")
            except Exception as e:   # noqa: BLE001
                log(f"github: {e}")
            self.sleep_or_reload(600)

