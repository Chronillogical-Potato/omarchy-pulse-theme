#!/usr/bin/env bash
# Zabbix current problems as Pulse status tiles. Read-only, except `--ack ID...` (Pulse 1.5: a double click on the
# storm of this panel, only if its source has ack = "...pulse-zabbix --ack" in pulse.toml).
# Needs: curl, jq. Env: ZABBIX_URL, ZABBIX_TOKEN (or args --url --token).
set -euo pipefail
URL="${ZABBIX_URL:-}"
TOKEN="${ZABBIX_TOKEN:-}"
LIMIT="${ZABBIX_LIMIT:-8}"
ACK=()
TIMEOUT="${PULSE_TIMEOUT:-15}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --url) URL="$2"; shift 2 ;;
    --token) TOKEN="$2"; shift 2 ;;
    --limit) LIMIT="$2"; shift 2 ;;
    --ack) shift; ACK=("$@"); break ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

if [[ -z "$URL" || -z "$TOKEN" ]]; then
  echo "set ZABBIX_URL and ZABBIX_TOKEN (or --url / --token)" >&2
  exit 1
fi

URL="${URL%/}"
[[ "$URL" == */api_jsonrpc.php ]] || URL="${URL}/api_jsonrpc.php"

if [[ ${#ACK[@]} -gt 0 ]]; then   # acknowledge these problems (event ids), with a message
  for id in "${ACK[@]}"; do [[ "$id" =~ ^[0-9]+$ ]] || { echo "not an event id: $id" >&2; exit 2; }; done
  BODY=$(jq -n --args '{jsonrpc: "2.0", method: "event.acknowledge", params: {eventids: $ARGS.positional, action: 6,
    message: "acknowledged from Omarchy Pulse"}, id: 1}' "${ACK[@]}")
  RESP=$(curl -sS --max-time "$TIMEOUT" -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json-rpc" -d "$BODY" "$URL")
  if echo "$RESP" | jq -e '.error' >/dev/null 2>&1; then
    echo "$RESP" | jq -r '.error.data // .error.message' >&2
    exit 1
  fi
  echo "acknowledged ${#ACK[@]}"
  exit 0
fi

BODY=$(jq -n --argjson limit "$LIMIT" '{
  jsonrpc: "2.0",
  method: "problem.get",
  params: {
    output: ["eventid", "name", "severity"],
    recent: true,
    sortfield: ["eventid"],
    sortorder: "DESC",
    limit: $limit
  },
  id: 1
}')

RESP=$(curl -sS --max-time "$TIMEOUT" \
  -H "Authorization: Bearer ${TOKEN}" \
  -H "Content-Type: application/json-rpc" \
  -d "$BODY" \
  "$URL")

if echo "$RESP" | jq -e '.error' >/dev/null 2>&1; then
  echo "$RESP" | jq -r '.error.message // .error.data // "zabbix api error"' >&2
  exit 1
fi

echo "$RESP" | jq '{
  type: "status",
  items: [
    (.result // [])[] | {
      id: .eventid,
      title: .name,
      level: (if ((.severity // "0") | tonumber) >= 4 then "crit"
              elif ((.severity // "0") | tonumber) >= 2 then "warn"
              else "info" end)
    }
  ]
}'
