{
 "format": "omarchy-pulse-scene",
 "v": 1,
 "name": "agent-bell",
 "title": "Agent bell",
 "author": "Marco Porro",
 "license": "MIT",
 "description": "A lantern for each AI agent, coloured by its state. When one starts waiting for you, a bell appears, rings and chimes; click it (or answer the agent) and it goes away. Lightning when an agent fails, a shooting star when one finishes.",
 "pulse": "1.7.0",
 "kind": "design",
 "tags": [
  "agents",
  "ai"
 ],
 "created": "2026-11-09",
 "design": {
  "v": 2,
  "sky": "none",
  "city": true,
  "shapes": [
   {
    "alpha": 0.3,
    "glow": 0,
    "anim": {
     "kind": "none",
     "speed": 1
    },
    "bind": [],
    "repeat": {
     "by": "none"
    },
    "id": "wire",
    "type": "line",
    "name": "wire",
    "x": 0.5,
    "y": 0.6,
    "w": 0.42,
    "h": 0,
    "fill": false,
    "line": 2,
    "color": "fg"
   },
   {
    "alpha": 0.95,
    "glow": 1,
    "anim": {
     "kind": "bob",
     "speed": 1
    },
    "bind": [],
    "repeat": {
     "by": "agents",
     "spread": true,
     "from": 0.32,
     "to": 0.68,
     "stateColors": true
    },
    "id": "lantern",
    "type": "ellipse",
    "name": "lantern",
    "x": 0.3,
    "y": 0.635,
    "w": 0.024,
    "h": 0.055,
    "color": "accent",
    "click": "{name} · {state}"
   },
   {
    "alpha": 1,
    "glow": 0.6,
    "anim": {
     "kind": "none",
     "speed": 1
    },
    "bind": [],
    "repeat": {
     "by": "none"
    },
    "id": "bell",
    "type": "image",
    "name": "bell",
    "asset": "bell",
    "x": 0.5,
    "y": 0.48,
    "w": 0.04,
    "h": 0.074,
    "hidden": true,
    "click": "an agent is waiting for you",
    "keys": {
     "start": "action",
     "loop": false,
     "dur": 1.2,
     "ease": "linear",
     "frames": [
      {
       "t": 0
      },
      {
       "t": 0.15,
       "rot": -18
      },
      {
       "t": 0.3,
       "rot": 16
      },
      {
       "t": 0.45,
       "rot": -12
      },
      {
       "t": 0.6,
       "rot": 9
      },
      {
       "t": 0.8,
       "rot": -4
      },
      {
       "t": 1
      }
     ]
    }
   },
   {
    "alpha": 0.65,
    "glow": 0,
    "anim": {
     "kind": "none",
     "speed": 1
    },
    "bind": [],
    "repeat": {
     "by": "none"
    },
    "id": "count",
    "type": "text",
    "name": "count",
    "x": 0.5,
    "y": 0.75,
    "w": 0.25,
    "h": 0.03,
    "text": "{working} working · {waiting} waiting",
    "size": 0.018,
    "color": "fg"
   }
  ],
  "assets": {
   "bell": "data:image/svg+xml;base64,"
  },
  "actions": [
   {
    "id": "a1",
    "when": {
     "type": "event",
     "event": "agent-waiting"
    },
    "do": [
     {
      "type": "show",
      "shape": "bell"
     },
     {
      "type": "play",
      "shape": "bell"
     },
     {
      "type": "fx",
      "fx": "chime",
      "text": "an agent needs you"
     }
    ],
    "cooldown": 20
   },
   {
    "id": "a2",
    "when": {
     "type": "event",
     "event": "click",
     "shape": "bell"
    },
    "do": [
     {
      "type": "hide",
      "shape": "bell"
     }
    ],
    "cooldown": 1
   },
   {
    "id": "a3",
    "when": {
     "type": "below",
     "src": "waiting",
     "value": 1
    },
    "do": [
     {
      "type": "hide",
      "shape": "bell"
     }
    ],
    "cooldown": 1
   },
   {
    "id": "a4",
    "when": {
     "type": "event",
     "event": "agent-failed"
    },
    "do": [
     {
      "type": "fx",
      "fx": "lightning",
      "text": "an agent failed"
     }
    ],
    "cooldown": 60
   },
   {
    "id": "a5",
    "when": {
     "type": "event",
     "event": "agent-done"
    },
    "do": [
     {
      "type": "fx",
      "fx": "shooting",
      "text": "{working} still working"
     }
    ],
    "cooldown": 60
   }
  ]
 },
 "preview": "data:image/webp;base64,"
}