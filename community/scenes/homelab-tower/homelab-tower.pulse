  "assets": {
   "rack": "data:image/svg+xml;base64,"
  },
  "actions": [
   {
    "id": "a1",
    "when": {
     "type": "event",
     "event": "click",
     "shape": "rack"
    },
    "do": [
     {
      "type": "play",
      "shape": "rack"
     },
     {
      "type": "fx",
      "fx": "banner",
      "text": "homelab {panel:power}"
     }
    ],
    "cooldown": 20
   },
   {
    "id": "a2",
    "when": {
     "type": "event",
     "event": "ci-fail"
    },
    "do": [
     {
      "type": "flash",
      "shape": "rack",
      "color": "crit",
      "secs": 5
     },
     {
      "type": "play",
      "shape": "rack"
     }
    ],
    "cooldown": 30
   },
   {
    "id": "a3",
    "when": {
     "type": "event",
     "event": "ci-ok"
    },
    "do": [
     {
      "type": "fx",
      "fx": "launch",
      "text": "deploy ok"
     }
    ],
    "cooldown": 60
   },
   {
    "id": "a4",
    "when": {
     "type": "above",
     "src": "panel:power",
     "value": 4
    },
    "do": [
     {
      "type": "flash",
      "shape": "beacon",
      "color": "warn",
      "secs": 6
     },
     {
      "type": "fx",
      "fx": "tip",
      "text": "power {panel:power}"
     }
    ],
    "cooldown": 600
   }
  ]
 },
