 "name": "homelab-tower",
 "title": "Homelab tower",
 "author": "Marco Porro",
 "license": "MIT",
 "description": "A server rack that grows with the power your homelab draws (a panel called \"power\"), with heat rising off it and a beacon on top. Click it: it shakes and says the power. CI fails: it flashes red. Over 4 kW: a balloon tells you.",
 "pulse": "1.7.0",
 "kind": "design",
 "tags": [
  "homelab",
  "power",
  "example"
 ],
 "created": "2026-11-09",
