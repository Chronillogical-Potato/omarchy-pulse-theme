      },
      {
       "t": 1
      }
     ]
    }
   },
   {
    "alpha": 1,
    "glow": 1.2,
    "anim": {
     "kind": "blink",
     "speed": 0.8
    },
    "bind": [
     {
      "prop": "y",
      "src": "panel:power",
      "from": 0.62,
