  "v": 2,
  "sky": "none",
  "city": true,
  "shapes": [
   {
    "alpha": 0.7,
    "glow": 0.6,
    "anim": {
     "kind": "none",
     "speed": 1
    },
    "bind": [
     {
      "prop": "count",
      "src": "panel:power",
      "from": 0,
      "to": 70,
      "lo": 0,
      "hi": 5
     },
     {
      "prop": "y",
      "src": "panel:power",
      "from": 0.6,
      "to": 0.33,
      "lo": 0,
      "hi": 5
     }
    ],
    "repeat": {
     "by": "none"
    },
