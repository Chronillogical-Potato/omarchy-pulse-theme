{
 "format": "omarchy-pulse-scene",
 "v": 1,
 "name": "moonlit-garden",
 "title": "Moonlit garden",
 "author": "Marco Porro",
 "license": "MIT",
 "description": "A night garden: a flower for every repo, its colour the CI, its size the commits of the week; fireflies for the agents at work; a Moon as bright as the real one; stars when the Sun is down. Fireworks at midnight, a shooting star when the ISS passes over.",
 "pulse": "1.7.0",
 "kind": "design",
 "tags": [
  "night",
  "git",
  "sky"
 ],
 "created": "2026-11-09",
 "design": {
  "v": 2,
  "sky": "none",
  "city": false,
  "shapes": [
   {
    "alpha": 1,
    "glow": 0.8,
    "anim": {
     "kind": "none",
     "speed": 1
    },
    "bind": [
     {
      "prop": "alpha",
      "src": "moon",
      "from": 0.25,
      "to": 1
     }
    ],
    "repeat": {
     "by": "none"
    },
    "id": "moon",
    "type": "image",
    "name": "moon",
    "asset": "moon",
    "x": 0.27,
    "y": 0.36,
    "w": 0.045,
    "h": 0.08,
    "click": "the Moon, {moon}% lit"
   },
   {
    "alpha": 0.75,
    "glow": 0,
    "anim": {
     "kind": "none",
     "speed": 1
    },
    "bind": [
     {
      "prop": "count",
      "src": "sun",
      "from": 120,
      "to": 0
     }
    ],
    "repeat": {
     "by": "none"
    },
    "id": "stars",
    "type": "particles",
    "name": "stars",
    "x": 0.5,
    "y": 0.48,
    "w": 0.44,
    "h": 0.24,
    "dir": "fireflies",
    "count": 60,
    "dot": 1.5,
    "color": "fg"
   },
   {
    "alpha": 0.18,
    "glow": 0,
    "anim": {
     "kind": "none",
     "speed": 1
    },
    "bind": [],
    "repeat": {
     "by": "none"
    },
    "id": "ground",
    "type": "rect",
    "name": "ground",
    "x": 0.5,
    "y": 0.8,
    "w": 0.46,
    "h": 0.1,
    "round": 1,
    "color": "ok"
   },
   {
    "alpha": 1,
    "glow": 0.5,
    "anim": {
     "kind": "sway",
     "speed": 0.5
    },
    "bind": [
     {
      "prop": "w",
      "src": "item",
      "from": 0.014,
      "to": 0.04
     },
     {
      "prop": "h",
      "src": "item",
      "from": 0.025,
      "to": 0.07
     }
    ],
    "repeat": {
     "by": "repos",
     "spread": true,
     "from": 0.36,
     "to": 0.64,
     "stateColors": true
    },
    "id": "flower",
    "type": "star",
    "name": "flower",
    "x": 0.35,
    "y": 0.76,
    "w": 0.026,
    "h": 0.046,
    "points": 6,
    "inner": 0.4,
    "color": "accent2",
    "click": "{name} · {state}"
   },
   {
    "alpha": 1,
    "glow": 1,
    "anim": {
     "kind": "none",
     "speed": 1
    },
    "bind": [
     {
      "prop": "count",
      "src": "working",
      "from": 3,
      "to": 50
     }
    ],
    "repeat": {
     "by": "none"
    },
    "id": "fireflies",
    "type": "particles",
    "name": "fireflies",
    "x": 0.5,
    "y": 0.68,
    "w": 0.44,
    "h": 0.14,
    "dir": "fireflies",
    "count": 6,
    "dot": 3,
    "color": "warn"
   }
  ],
  "assets": {
   "moon": "data:image/svg+xml;base64,"
  },
  "actions": [
   {
    "id": "a1",
    "when": {
     "type": "below",
     "src": "hour",
     "value": 0.1
    },
    "do": [
     {
      "type": "fx",
      "fx": "fireworks",
      "text": "midnight"
     }
    ],
    "cooldown": 600
   },
   {
    "id": "a2",
    "when": {
     "type": "event",
     "event": "iss"
    },
    "do": [
     {
      "type": "fx",
      "fx": "shooting",
      "text": "the ISS is passing over"
     }
    ],
    "cooldown": 600
   },
   {
    "id": "a3",
    "when": {
     "type": "event",
     "event": "commit"
    },
    "do": [
     {
      "type": "flash",
      "shape": "flower",
      "color": "warn",
      "secs": 2
     }
    ],
    "cooldown": 10
   }
  ]
 },
 "preview": "data:image/webp;base64,"
}