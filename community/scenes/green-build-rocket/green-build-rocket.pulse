    "w": 0.032,
    "h": 0.19,
    "color": "accent",
    "click": "{commits} commits this week",
    "keys": {
     "start": "action",
     "loop": false,
     "dur": 4.5,
     "ease": "smooth",
     "frames": [
      {
       "t": 0
      },
      {
       "t": 0.12,
       "dx": 0.002
      },
      {
       "t": 0.22,
