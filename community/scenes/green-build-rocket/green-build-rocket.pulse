{
 "format": "omarchy-pulse-scene",
 "v": 1,
 "name": "green-build-rocket",
 "title": "Green build rocket",
 "author": "Marco Porro",
 "license": "MIT",
 "description": "A rocket of your own on its launch pad. CI passes again: it lifts off with Pulse's own rocket. CI fails: it flashes red, and the light on the tower turns red while a build is failing. Smoke follows your agents at work; stars come out when the Sun goes down. Click it to launch it.",
 "pulse": "1.7.0",
 "kind": "design",
 "tags": [
  "ci",
  "git",
  "rocket"
 ],
 "created": "2026-11-09",
