   }
  ],
  "assets": {
   "rocket": "data:image/svg+xml;base64,"
  },
  "actions": [
   {
    "id": "a1",
    "when": {
     "type": "event",
     "event": "ci-ok"
    },
    "do": [
     {
      "type": "play",
      "shape": "rocket"
     },
     {
      "type": "fx",
      "fx": "launch",
      "text": "build green"
     }
    ],
    "cooldown": 30
   },
   {
    "id": "a2",
    "when": {
     "type": "event",
     "event": "ci-fail"
    },
    "do": [
     {
      "type": "flash",
      "shape": "rocket",
      "color": "crit",
      "secs": 6
     }
    ],
    "cooldown": 30
   },
   {
    "id": "a3",
    "when": {
     "type": "event",
     "event": "click",
     "shape": "rocket"
    },
    "do": [
     {
      "type": "play",
      "shape": "rocket"
     }
    ],
    "cooldown": 8
   }
  ]
 },
 "preview": "data:image/webp;base64,"
