 "name": "blackout-room",
 "title": "Blackout room",
 "author": "Anatolii (tolixx)",
 "license": "MIT",
 "description": "A server room on a dark street. The houses' windows and the line from the pole follow the grid (a panel called grid: the share of your UPSes on grid power, 0-100), the battery bank follows a panel called ups (in %), the meter on the roof your draw (watts, 0-500 W). Power cut: the street goes dark, lightning, \"on battery\"; the rack keeps blinking, greener on a full battery, redder as it drains.",
 "pulse": "1.7.0",
 "kind": "design",
 "tags": [
  "homelab",
  "power",
  "ups",
  "blackout"
 ],
 "created": "2026-11-10",
