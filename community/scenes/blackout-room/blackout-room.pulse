  "actions": [
   {
    "id": "a1",
    "when": {
     "type": "event",
     "event": "click",
     "shape": "room"
    },
    "do": [
     {
      "type": "fx",
      "fx": "banner",
      "text": "{panel:watts} W · ups {panel:ups}%"
     }
    ],
    "cooldown": 15
   },
   {
    "id": "a2",
    "when": {
     "type": "below",
     "src": "panel:grid",
     "value": 1
    },
    "do": [
     {
      "type": "fx",
      "fx": "lightning",
      "text": "power cut: on battery"
     },
     {
      "type": "flash",
      "shape": "room-wall",
      "color": "crit",
      "secs": 8
     }
    ],
    "cooldown": 120
   },
   {
    "id": "a3",
    "when": {
     "type": "above",
     "src": "panel:grid",
     "value": 0
    },
    "do": [
     {
      "type": "fx",
      "fx": "chime",
      "text": "the grid is back"
     },
     {
      "type": "flash",
      "shape": "wire",
      "color": "ok",
      "secs": 4
     }
    ],
    "cooldown": 120
   },
   {
    "id": "a4",
    "when": {
     "type": "below",
     "src": "panel:ups",
