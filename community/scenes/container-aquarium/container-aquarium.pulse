  "actions": [
   {
    "id": "a1",
    "when": {
     "type": "event",
     "event": "row-crit"
    },
    "do": [
     {
      "type": "flash",
      "shape": "glass",
      "color": "crit",
      "secs": 6
     },
     {
      "type": "fx",
      "fx": "lightning",
      "text": "a container is down"
     }
    ],
    "cooldown": 120
   },
   {
    "id": "a2",
    "when": {
     "type": "event",
     "event": "row-ok"
    },
    "do": [
     {
      "type": "fx",
      "fx": "shooting",
      "text": "containers all up"
     }
    ],
    "cooldown": 120
   }
  ]
 },
